<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Lightflow.Application/Lightflow.Application.csproj" />
    <ProjectReference Include="../Lightflow.Catalog/Lightflow.Catalog.csproj" />
    <None Include="native/libLightflowStorage.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="libLightflowStorage.dylib" />
  </ItemGroup>
  <Target Name="BuildMacStorageNative" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="xcrun clang -dynamiclib -fobjc-arc -Wall -Wextra -Werror -install_name @rpath/libLightflowStorage.dylib -framework Foundation -framework AppKit -framework AVFoundation -framework CoreMedia -framework ImageIO -framework CoreGraphics -framework UniformTypeIdentifiers &quot;$(MSBuildProjectDirectory)/native/storage.m&quot; &quot;$(MSBuildProjectDirectory)/native/catalog.c&quot; &quot;$(MSBuildProjectDirectory)/native/locations.m&quot; &quot;$(MSBuildProjectDirectory)/native/thumbnails.m&quot; -o &quot;$(MSBuildProjectDirectory)/native/libLightflowStorage.dylib&quot;" />
  </Target>
</Project>
