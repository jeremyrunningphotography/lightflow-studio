<Window x:Class="LightflowStudio.AddToCollectionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="480" Height="520" MinHeight="380" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="12">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Style="{StaticResource PageTitle}" FontSize="20" Text="Add to Collection"/>
   <TextBlock Grid.Row="1" x:Name="SelectionSummary" Margin="0,6,0,10" Foreground="{StaticResource MutedTextBrush}"/>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
    <ItemsControl x:Name="CollectionChoices">
     <ItemsControl.ItemTemplate><DataTemplate>
      <CheckBox Margin="4,6" Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button HorizontalAlignment="Left" Content="New Collection…" Click="NewCollection_Click"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button IsCancel="True" Content="Cancel"/><Button IsDefault="True" Content="Add" Click="Add_Click"/></StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
