<Window x:Class="LightflowStudio.CatalogBackupDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Back Up Catalog" Width="600" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="14">
  <StackPanel>
   <TextBlock Style="{StaticResource PageTitle}" FontSize="21" Text="Back Up Catalog"/>
   <TextBlock x:Name="Explanation" Margin="0,8,0,12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
    Text="Save a validated copy of your Lightflow Catalog before closing. Original media and rebuildable Previews are not included."/>
   <TextBlock Style="{StaticResource FieldLabel}" Text="BACKUP LOCATION"/>
   <DockPanel>
    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Change…" Click="Browse_Click"/>
    <TextBox x:Name="Destination" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalContentAlignment="Center" AutomationProperties.Name="Catalog backup location"/>
   </DockPanel>
   <TextBlock Margin="0,8,0,12" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
    Text="Each backup is kept until you delete it. Changing this location also updates Settings."/>
   <TextBlock x:Name="StatusText" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
   <ProgressBar x:Name="Progress" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="StayButton" Content="Keep Using Lightflow" Click="Stay_Click"/>
    <Button x:Name="SkipButton" Content="Skip This Time" Click="Skip_Click"/>
    <Button x:Name="BackupButton" Style="{StaticResource PrimaryButton}" Content="Back Up &amp; Exit" Click="Backup_Click" IsDefault="True"/>
    <Button x:Name="CancelBackupButton" Content="Cancel" Click="CancelBackup_Click" Visibility="Collapsed"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
