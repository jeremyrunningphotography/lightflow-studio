<Window x:Class="LightflowStudio.CatalogDestinationDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="720" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="18">
  <StackPanel>
   <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}"/>
   <TextBlock x:Name="Description" Margin="0,10,0,16" TextWrapping="Wrap"/>
   <TextBlock x:Name="LocationLabel" Text="Lightflow Catalog Location" Style="{StaticResource FieldLabel}"/>
   <Grid Margin="0,6,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="Destination" VerticalContentAlignment="Center" TextWrapping="Wrap" MinHeight="54" TextChanged="Location_Changed"/>
    <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/>
   </Grid>
   <StackPanel x:Name="MoveChildFields" Visibility="Collapsed">
    <TextBlock Text="New Catalog folder name" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="ChildName" Margin="0,6,0,12" TextChanged="Location_Changed"/>
    <TextBlock Text="Resulting Lightflow Catalog Location" Style="{StaticResource FieldLabel}"/>
    <TextBlock x:Name="FinalLocation" Margin="0,6,0,12" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
   </StackPanel>
   <TextBlock x:Name="LocationHint" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
   <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource RedBrush}"/>
   <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button IsCancel="True" Content="Cancel"/>
    <Button x:Name="ActionButton" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Accept_Click"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
