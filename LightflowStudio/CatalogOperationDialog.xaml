<Window x:Class="LightflowStudio.CatalogOperationDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Catalog operation" Width="600" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="14">
  <StackPanel>
   <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="21" TextWrapping="Wrap"/>
   <TextBlock x:Name="Detail" Margin="0,8,0,12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
   <TextBlock x:Name="StatusText" Margin="0,0,0,12" TextWrapping="Wrap"/>
   <StackPanel x:Name="MoveSuccessPanel" Visibility="Collapsed">
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock x:Name="SuccessIcon" Text="✓" FontSize="30" Foreground="{StaticResource SuccessBrush}" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="Success"/>
     <TextBlock Grid.Column="1" x:Name="SuccessHeading" Text="Catalog moved successfully" Style="{StaticResource PageTitle}" FontSize="21" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock x:Name="SuccessMessage" Text="You can continue using Lightflow Studio." Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>
    <TextBlock x:Name="SuccessLocationLabel" Text="New Catalog location" Style="{StaticResource FieldLabel}"/>
    <TextBlock x:Name="SuccessLocation" Margin="0,5,0,16" TextWrapping="Wrap"/>
   </StackPanel>
   <Expander x:Name="FailureDetails" Header="Troubleshooting details" Style="{StaticResource SettingsExpanderStyle}" Visibility="Collapsed" IsExpanded="False" Margin="0,0,0,12">
    <Border Style="{StaticResource Card}" Padding="10"><ScrollViewer MaxHeight="180"><TextBlock x:Name="FailureDiagnostic" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/></ScrollViewer></Border>
   </Expander>
   <ProgressBar x:Name="Progress" Height="5" IsIndeterminate="True" Margin="0,0,0,12"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"/>
    <Button x:Name="CloseButton" Content="Close" IsDefault="True" Visibility="Collapsed" Click="Close_Click"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
