<Window x:Class="LightflowStudio.CatalogSetupDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Lightflow Studio" Width="720" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="18">
  <StackPanel>
   <TextBlock Text="Lightflow Studio" Style="{StaticResource FieldLabel}" Margin="0,0,0,12"/>
   <TextBlock x:Name="GateHeading" Style="{StaticResource PageTitle}" FontSize="23" TextWrapping="Wrap"/>
   <TextBlock x:Name="GateDescription" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" LineHeight="19"/>
   <TextBlock x:Name="GateLocationLabel" Style="{StaticResource FieldLabel}" Text="Lightflow Catalog Location"/>
   <TextBlock x:Name="NewLocation" Margin="0,4,0,10" TextWrapping="Wrap"/>
   <StackPanel x:Name="AllowedWorkspacePanel" Visibility="Collapsed" Margin="0,0,0,10">
    <TextBlock Text="Choose a Catalog folder inside this workspace" Style="{StaticResource FieldLabel}"/>
    <TextBlock x:Name="AllowedWorkspace" Margin="0,4,0,0" TextWrapping="Wrap"/>
   </StackPanel>
   <TextBlock x:Name="GateAssurance" Margin="0,0,0,8" Text="Open an existing Lightflow Catalog or create a new one to continue." TextWrapping="Wrap" Visibility="Collapsed"/>
   <TextBlock x:Name="GateProgress" Margin="0,0,0,8" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed" Text="Opening Catalog…"/>
   <Expander x:Name="GateDetails" Header="Troubleshooting details" Style="{StaticResource SettingsExpanderStyle}" IsExpanded="False" Visibility="Collapsed" Margin="0,0,0,12">
    <Border Style="{StaticResource Card}" Padding="10"><ScrollViewer MaxHeight="180"><TextBlock x:Name="GateDiagnostic" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/></ScrollViewer></Border>
   </Expander>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="GateExitButton" IsCancel="True" Content="Exit" Click="Cancel_Click"/>
    <Button x:Name="GateRetryButton" Content="Retry" Click="Retry_Click"/>
    <Button x:Name="GateOpenButton" Content="Open Existing Catalog…" Click="Open_Click"/>
    <Button x:Name="GateCreateButton" Style="{StaticResource PrimaryButton}" Content="Create New Catalog…" Click="Create_Click" IsDefault="True"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
