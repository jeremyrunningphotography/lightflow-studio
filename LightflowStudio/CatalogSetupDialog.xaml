<Window x:Class="LightflowStudio.CatalogSetupDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Choose a Catalog" Width="600" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="14">
  <StackPanel>
   <TextBlock Style="{StaticResource PageTitle}" FontSize="21" Text="Choose your Lightflow Catalog"/>
   <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Text="A Catalog keeps your Collections, ratings, metadata and edits. Create a new Catalog here, or open a Catalog you already have. Media and LUT folders can be unavailable without losing your assignments."/>
   <TextBlock Style="{StaticResource FieldLabel}" Text="NEW CATALOG LOCATION"/>
   <TextBlock x:Name="NewLocation" Margin="0,4,0,12" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button IsCancel="True" Content="Cancel" Click="Cancel_Click"/>
    <Button Content="Open Existing Catalog…" Click="Open_Click"/>
    <Button Style="{StaticResource PrimaryButton}" Content="Create New Catalog" Click="Create_Click" IsDefault="True"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
