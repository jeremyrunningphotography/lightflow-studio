<Window x:Class="LightflowStudio.ConfirmationDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Confirm action" Width="500" MinHeight="250" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="10">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="HeadingText" Style="{StaticResource PageTitle}" FontSize="21" TextWrapping="Wrap"/>
   <TextBlock Grid.Row="1" x:Name="MessageText" Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
   <Border Grid.Row="2" x:Name="DetailSurface" Margin="0,5,0,0" Padding="5,4" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="1" CornerRadius="6">
    <TextBlock x:Name="DetailText" Foreground="{StaticResource TextBrush}" FontSize="11" TextWrapping="Wrap"/>
   </Border>
   <StackPanel Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button IsCancel="True" Content="Keep Jobs" Click="Cancel_Click"/>
    <Button x:Name="ConfirmButton" IsDefault="True" Style="{StaticResource DangerButton}" Content="Confirm" Click="Confirm_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
