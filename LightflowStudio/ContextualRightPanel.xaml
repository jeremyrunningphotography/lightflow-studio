<UserControl x:Class="LightflowStudio.ContextualRightPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AutomationProperties.Name="Contextual Right Panel">
 <Border Background="{DynamicResource ShellPanelBrush}" BorderBrush="{DynamicResource ShellDividerBrush}" BorderThickness="1,0,0,0">
  <DockPanel>
   <Button DockPanel.Dock="Top" Content="Close panel" HorizontalAlignment="Right" Margin="8,6"
    AutomationProperties.Name="Close Right Panel" Click="Close_Click"/>
   <TabControl x:Name="SurfaceTabs" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="0" ItemContainerStyle="{DynamicResource ContextualTab}"
    AutomationProperties.Name="Contextual surfaces" SelectionChanged="Tabs_SelectionChanged"/>
  </DockPanel>
 </Border>
</UserControl>
