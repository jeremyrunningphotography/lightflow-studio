<Window x:Class="LightflowStudio.ExportDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Export" Width="1120" Height="800" MinWidth="940" MinHeight="680" WindowStartupLocation="CenterOwner" Background="{DynamicResource ShellCanvasBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="NamePartChip" TargetType="Border"><Setter Property="Width" Value="112"/><Setter Property="Background" Value="{DynamicResource ShellRaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ShellDividerBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,0,6,6"/></Style>
  <Style x:Key="ChipButton" TargetType="Button"><Setter Property="MinWidth" Value="22"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="3,0"/><Setter Property="Margin" Value="2,3,0,0"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource ShellDividerBrush}"/></Style>
  <Style x:Key="InfoButton" TargetType="Button"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Content" Value="ⓘ"/><Setter Property="Focusable" Value="True"/><EventSetter Event="GotKeyboardFocus" Handler="InfoButton_GotKeyboardFocus"/><EventSetter Event="LostKeyboardFocus" Handler="InfoButton_LostKeyboardFocus"/></Style>
  <Style x:Key="AdvancedToggle" TargetType="ToggleButton"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5" Padding="10,7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ShellPanelBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ShellPanelBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ShellSurfaceBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="AdvancedDisclosure" TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><Border x:Name="UnifiedAdvancedBox" Background="{DynamicResource ShellRaisedBrush}" BorderBrush="{DynamicResource ShellDividerBrush}" BorderThickness="1" CornerRadius="5"><StackPanel><ToggleButton Style="{StaticResource AdvancedToggle}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Advanced export settings"><Grid><TextBlock x:Name="DisclosureIcon" Text="▸"/><TextBlock Margin="20,0,0,0" Text="Advanced" FontWeight="SemiBold"/></Grid></ToggleButton><ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" ContentSource="Content"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="DisclosureIcon" Property="Text" Value="▾"/><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/><Setter TargetName="UnifiedAdvancedBox" Property="Background" Value="{DynamicResource ShellSurfaceBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="UnifiedAdvancedBox" Property="BorderBrush" Value="{DynamicResource ShellFocusBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="AdvancedLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource NavigationTextBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock FontSize="23" FontWeight="SemiBold" Text="Export"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Configure this export, then return immediately to your work."/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel>
    <Border Style="{StaticResource ShellPanel}" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="Destination"/><TextBlock Margin="0,8,0,4" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="OUTPUT FOLDER"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DestinationText" AutomationProperties.Name="Output folder" TextChanged="Configuration_Changed"/><Button Grid.Column="1" Margin="7,0,0,0" Content="Browse…" Click="Browse_Click" AutomationProperties.Name="Browse for output folder"/></Grid><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="CreateSubfolderCheck" VerticalAlignment="Center" Content="Create subfolder" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><TextBox x:Name="SubfolderText" Grid.Column="1" Margin="10,0,0,0" Text="Exports" AutomationProperties.Name="Export subfolder name" TextChanged="Configuration_Changed"/></Grid><Border x:Name="OutputExampleBorder" MinHeight="58" Margin="0,8,0,0" Padding="9,7" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellDividerBrush}" BorderThickness="1" CornerRadius="4"><StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="OUTPUT EXAMPLE"/><TextBlock x:Name="PathPreview" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource NavigationTextBrush}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.Name="Complete output example path"/></StackPanel></Border></StackPanel></Border>
    <Border Style="{StaticResource ShellPanel}" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="File Naming"/>
     <WrapPanel x:Name="FilenameComposer" Margin="0,8,0,0"><ItemsControl x:Name="NamePartsComposer"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource NamePartChip}" AllowDrop="True" Drop="NamePart_Drop" PreviewMouseLeftButtonDown="NamePart_MouseDown" PreviewMouseMove="NamePart_MouseMove" AutomationProperties.Name="{Binding AutomationName}"><StackPanel><TextBlock x:Name="PartLabel" HorizontalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><TextBox x:Name="CustomPartText" Width="96" Text="{Binding Part.Text, Mode=OneWay}" Visibility="Collapsed" TextChanged="CustomPartText_Changed" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" ToolTip="{Binding Part.Text}" AutomationProperties.Name="Custom text name part value"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource ChipButton}" Content="◀" Click="MovePartEarlier_Click" AutomationProperties.Name="{Binding MoveEarlierAutomationName}"/><Button Style="{StaticResource ChipButton}" Content="▶" Click="MovePartLater_Click" AutomationProperties.Name="{Binding MoveLaterAutomationName}"/><Button Style="{StaticResource ChipButton}" Content="×" Click="RemovePart_Click" AutomationProperties.Name="{Binding RemoveAutomationName}"/></StackPanel></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsCustomText}" Value="True"><Setter TargetName="PartLabel" Property="Visibility" Value="Collapsed"/><Setter TargetName="CustomPartText" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Margin="0,0,0,6" Padding="4,5" VerticalAlignment="Top"><TextBlock x:Name="ExtensionPreview" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Output filename extension"/></Border></WrapPanel>
     <StackPanel Orientation="Horizontal"><ComboBox x:Name="AddPartCombo" Width="175" Height="30" DisplayMemberPath="Label" AutomationProperties.Name="Name part to add"/><Button Height="30" Margin="6,0,0,0" Padding="12,0" Content="+ Add" Click="AddPart_Click" AutomationProperties.Name="Add name part"/></StackPanel>
     <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="SEPARATOR"/><ComboBox x:Name="SeparatorCombo" DisplayMemberPath="Label" AutomationProperties.Name="Filename separator" SelectionChanged="Configuration_Changed"/></StackPanel><CheckBox x:Name="OverwriteExistingCheck" Grid.Column="1" Margin="14,17,0,0" VerticalAlignment="Top" Content="Overwrite existing files" AutomationProperties.Name="Overwrite existing files" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/></Grid>
     <TextBlock Margin="0,8,0,3" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="FILENAME PREVIEW"/><TextBlock x:Name="NamePreview" FontWeight="SemiBold" AutomationProperties.Name="Filename preview"/>
    </StackPanel></Border>
    <Border Style="{StaticResource ShellPanel}" Padding="14"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="Color"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="CAMERA LUT"/><ComboBox x:Name="CameraCombo" DisplayMemberPath="Label" AutomationProperties.Name="Camera LUT policy" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="CREATIVE LUT"/><ComboBox x:Name="CreativeCombo" DisplayMemberPath="Label" AutomationProperties.Name="Creative LUT policy" SelectionChanged="Configuration_Changed"/></StackPanel></Grid></StackPanel></Border>
   </StackPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Border Style="{StaticResource ShellPanel}" Padding="14"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="Export Settings"/>
    <Grid x:Name="PrimarySettings" Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="Format"/><Button x:Name="FormatInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About output format" ToolTip="The container used for exported files. Same as Source preserves each input's compatible container."/></StackPanel><ComboBox x:Name="ContainerCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Output format" SelectionChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="Video codec"/><Button x:Name="CodecInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About video codec" ToolTip="The video compression format used for export. Same as Source re-encodes using the source codec when supported."/></StackPanel><ComboBox x:Name="CodecCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Video codec" SelectionChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="Resolution"/><Button x:Name="ResolutionInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About output resolution" ToolTip="Lower presets preserve aspect ratio at the selected height. 4K fits into and pads a 3840 × 2160 canvas."/></StackPanel><ComboBox x:Name="ResolutionCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Output resolution" SelectionChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="Frame rate"/><Button x:Name="FrameRateInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About frame rate" ToolTip="Controls exported video cadence. Same as Source preserves the source frame rate while re-encoding."/></StackPanel><ComboBox x:Name="FrameRateCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Frame rate" SelectionChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="Quality mode"/><Button x:Name="RateControlInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About quality mode" ToolTip="Chooses whether export is controlled by visual quality, variable bitrate, or constant bitrate."/></StackPanel><ComboBox x:Name="RateControlCombo" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Quality mode" SelectionChanged="Configuration_Changed"/>
     <StackPanel x:Name="QualityPrimaryLabel" Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="Quality / CQ"/><Button x:Name="QualityInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About constant quality" ToolTip="Lower CQ values preserve more visual detail and produce larger files."/></StackPanel><TextBox x:Name="QualityText" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Constant quality value" TextChanged="Configuration_Changed"/>
     <StackPanel x:Name="TargetPrimaryLabel" Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="Target bitrate"/><Button x:Name="TargetInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About target bitrate" ToolTip="The average video bitrate used by Variable Bitrate mode, in megabits per second."/></StackPanel><TextBox x:Name="TargetText" Grid.Row="6" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Target bitrate" TextChanged="Configuration_Changed"/>
     <StackPanel x:Name="MaxPrimaryLabel" Grid.Row="7" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="Maximum bitrate"/><Button x:Name="MaxInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About maximum bitrate" ToolTip="The peak video bitrate allowed by Variable Bitrate mode, in megabits per second."/></StackPanel><TextBox x:Name="MaxText" Grid.Row="7" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Maximum bitrate" TextChanged="Configuration_Changed"/>
     <StackPanel x:Name="CbrPrimaryLabel" Grid.Row="8" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="CBR bitrate"/><Button x:Name="CbrInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About constant bitrate" ToolTip="The fixed video bitrate used by Constant Bitrate mode, in megabits per second."/></StackPanel><TextBox x:Name="CbrText" Grid.Row="8" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Constant bitrate" TextChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="9" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="Audio"/><Button x:Name="AudioInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About audio handling" ToolTip="Controls whether source audio is preserved, encoded as AAC, or omitted. Source audio uses AAC fallback when copy is incompatible."/></StackPanel><ComboBox x:Name="AudioCombo" Grid.Row="9" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Audio handling" SelectionChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="10" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="Encoder"/><Button x:Name="EncoderInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About encoder" ToolTip="Lightflow currently uses NVIDIA hardware encoding and verifies availability before Export."/></StackPanel><ComboBox x:Name="EncoderCombo" Grid.Row="10" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Encoder backend" IsEnabled="False"/>
     <StackPanel Grid.Row="11" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabel}" Text="Parallel exports"/><Button x:Name="ParallelInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About parallel exports" ToolTip="Maximum number of files Lightflow exports simultaneously. This is not FFmpeg thread count."/></StackPanel><ComboBox x:Name="ParallelCombo" Grid.Row="11" Grid.Column="1" AutomationProperties.Name="Parallel exports" SelectionChanged="Configuration_Changed"/>
    </Grid>
    <Border Margin="0,4,0,8" Padding="9,7" Background="{DynamicResource ShellRaisedBrush}" CornerRadius="5"><StackPanel><TextBlock x:Name="HardwareStatusHeading" FontWeight="SemiBold"/><TextBlock x:Name="EncoderDiagnostic" Margin="0,2,0,0" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border>
    <Expander x:Name="AdvancedExpander" Style="{StaticResource AdvancedDisclosure}" Expanded="Configuration_Changed" Collapsed="Configuration_Changed"><Border Padding="12" Background="Transparent" BorderBrush="{DynamicResource ShellDividerBrush}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource AdvancedLabel}" Text="NVENC PRESET (P1–P7)"/><Button x:Name="PresetInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About NVENC preset" ToolTip="Controls the tradeoff between encoding speed and compression efficiency. Higher preset values generally spend more GPU time for better efficiency."/></StackPanel><TextBox x:Name="PresetText" AutomationProperties.Name="NVIDIA NVENC preset" TextChanged="Configuration_Changed"/><StackPanel Margin="0,8,0,0" Orientation="Horizontal"><TextBlock Style="{StaticResource AdvancedLabel}" Text="TUNE"/><Button x:Name="TuneInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About NVENC tune" ToolTip="Optimizes NVENC behavior for quality or latency-sensitive workloads."/></StackPanel><ComboBox x:Name="TuneCombo" DisplayMemberPath="Label" AutomationProperties.Name="Encoder tune" SelectionChanged="Configuration_Changed"/><StackPanel Margin="0,8,0,0" Orientation="Horizontal"><TextBlock Style="{StaticResource AdvancedLabel}" Text="MULTIPASS"/><Button x:Name="MultipassInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About multipass" ToolTip="Allows NVENC to analyze the video more than once to improve bitrate allocation and quality."/></StackPanel><ComboBox x:Name="MultipassCombo" DisplayMemberPath="Label" AutomationProperties.Name="Multipass mode" SelectionChanged="Configuration_Changed"/><StackPanel Margin="0,8,0,0" Orientation="Horizontal"><TextBlock Style="{StaticResource AdvancedLabel}" Text="PIXEL FORMAT"/><Button x:Name="PixelFormatInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About pixel format" ToolTip="Controls output chroma sampling and bit depth. Some formats require HEVC."/></StackPanel><ComboBox x:Name="PixelFormatCombo" DisplayMemberPath="Label" AutomationProperties.Name="Pixel format" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource AdvancedLabel}" Text="AQ STRENGTH"/><Button x:Name="AqInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About adaptive quantization strength" ToolTip="Controls how strongly adaptive quantization redistributes quality across detailed and flat areas."/></StackPanel><TextBox x:Name="AqText" AutomationProperties.Name="Adaptive quantization strength" TextChanged="Configuration_Changed"/><StackPanel Margin="0,10,0,0" Orientation="Horizontal"><CheckBox x:Name="SpatialAqCheck" Content="Spatial AQ" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><Button x:Name="SpatialAqInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About spatial adaptive quantization" ToolTip="Adjusts compression within each frame to preserve visually important detail."/></StackPanel><StackPanel Margin="0,7,0,0" Orientation="Horizontal"><CheckBox x:Name="TemporalAqCheck" Content="Temporal AQ" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><Button x:Name="TemporalAqInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About temporal adaptive quantization" ToolTip="Adjusts compression across frames to preserve detail in changing areas over time."/></StackPanel><StackPanel Margin="0,7,0,0" Orientation="Horizontal"><CheckBox x:Name="DeinterlaceCheck" Content="Deinterlace" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><Button x:Name="DeinterlaceInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About deinterlacing" ToolTip="Converts interlaced source video to progressive output."/></StackPanel><StackPanel Margin="0,7,0,0" Orientation="Horizontal"><CheckBox x:Name="FastStartCheck" Content="Fast Start" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><Button x:Name="FastStartInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About fast start" ToolTip="Moves MP4 metadata to the beginning of the file so playback can begin before the full file is downloaded."/></StackPanel></StackPanel></Grid></Border></Expander>
   </StackPanel></Border></StackPanel></ScrollViewer>
  </Grid>
  <Border x:Name="ValidationBorder" Grid.Row="2" Margin="0,10,0,0" Padding="10,7" Background="{DynamicResource ShellRaisedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="5" Visibility="Collapsed"><TextBlock x:Name="ValidationText" TextWrapping="Wrap"/></Border>
  <DockPanel Grid.Row="3" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Width="92" Content="Cancel" IsCancel="True"/><Button x:Name="ExportButton" Width="108" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Content="Export" Click="Export_Click"/></StackPanel><TextBlock x:Name="QueueError" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#FFFF8A80" TextWrapping="Wrap"/></DockPanel>
 </Grid>
</Window>
