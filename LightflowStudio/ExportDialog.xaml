  <Style x:Key="CqSliderStyle" TargetType="Slider" BasedOn="{StaticResource BoundedSliderStyle}"><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="51"/></Style>
  <Style x:Key="AqSliderStyle" TargetType="Slider" BasedOn="{StaticResource BoundedSliderStyle}"><Setter Property="Minimum" Value="1"/><Setter Property="Maximum" Value="15"/></Style>
  <Style x:Key="StableVerticalScrollViewer" TargetType="ScrollViewer"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><Grid><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="0,0,14,0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/><ScrollBar x:Name="PART_VerticalScrollBar" Width="14" HorizontalAlignment="Right" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock x:Name="ExportHeading" FontSize="23" FontWeight="SemiBold" Text="Export"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Configure this export, then return immediately to your work."/></StackPanel>
  <ScrollViewer x:Name="ExportContentScroll" Grid.Row="1" Style="{StaticResource StableVerticalScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel>
    <Border Style="{StaticResource ShellPanel}" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="Destination"/><TextBlock Margin="0,8,0,4" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="OUTPUT FOLDER"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DestinationText" AutomationProperties.Name="Output folder" TextChanged="Configuration_Changed"/><Button Grid.Column="1" Margin="7,0,0,0" Content="Browse…" Click="Browse_Click" AutomationProperties.Name="Browse for output folder"/></Grid><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="CreateSubfolderCheck" VerticalAlignment="Center" Content="Create subfolder" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><TextBox x:Name="SubfolderText" Grid.Column="1" Margin="10,0,0,0" Text="Exports" AutomationProperties.Name="Export subfolder name" TextChanged="Configuration_Changed"/></Grid><Border x:Name="OutputExampleBorder" MinHeight="58" Margin="0,8,0,0" Padding="9,7" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellDividerBrush}" BorderThickness="1" CornerRadius="4"><StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="OUTPUT EXAMPLE"/><TextBlock x:Name="PathPreview" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.Name="Complete output example path"/></StackPanel></Border></StackPanel></Border>
    <Border Style="{StaticResource ShellPanel}" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="File Naming"/>
     <WrapPanel x:Name="FilenameComposer" Margin="0,8,0,0"><ItemsControl x:Name="NamePartsComposer"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource NamePartChip}" AllowDrop="True" Drop="NamePart_Drop" PreviewMouseLeftButtonDown="NamePart_MouseDown" PreviewMouseMove="NamePart_MouseMove" AutomationProperties.Name="{Binding AutomationName}"><StackPanel><TextBlock x:Name="PartLabel" HorizontalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><TextBox x:Name="CustomPartText" Width="88" Height="30" Margin="0" Padding="6,2" VerticalContentAlignment="Center" Text="{Binding Part.Text, Mode=OneWay}" Visibility="Collapsed" TextChanged="CustomPartText_Changed" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" ToolTip="{Binding Part.Text}" AutomationProperties.Name="Custom text name part value"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource ChipButton}" Content="◀" Click="MovePartEarlier_Click" AutomationProperties.Name="{Binding MoveEarlierAutomationName}"/><Button Style="{StaticResource ChipButton}" Content="▶" Click="MovePartLater_Click" AutomationProperties.Name="{Binding MoveLaterAutomationName}"/><Button Style="{StaticResource ChipButton}" Content="×" Click="RemovePart_Click" AutomationProperties.Name="{Binding RemoveAutomationName}"/></StackPanel></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsCustomText}" Value="True"><Setter TargetName="PartLabel" Property="Visibility" Value="Collapsed"/><Setter TargetName="CustomPartText" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Margin="0,0,0,6" Padding="4,5" VerticalAlignment="Top"><TextBlock x:Name="ExtensionPreview" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Output filename extension"/></Border></WrapPanel>
     <StackPanel Orientation="Horizontal"><ComboBox x:Name="AddPartCombo" Width="175" Height="30" DisplayMemberPath="Label" AutomationProperties.Name="Name part to add"/><Button Height="30" Margin="6,0,0,0" Padding="12,0" Content="+ Add" Click="AddPart_Click" AutomationProperties.Name="Add name part"/></StackPanel>
     <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="SEPARATOR"/><ComboBox x:Name="SeparatorCombo" DisplayMemberPath="Label" AutomationProperties.Name="Filename separator" SelectionChanged="Configuration_Changed"/></StackPanel><CheckBox x:Name="OverwriteExistingCheck" Grid.Column="1" Margin="14,17,0,0" VerticalAlignment="Top" Content="Overwrite existing files" AutomationProperties.Name="Overwrite existing files" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/></Grid>
     <TextBlock Margin="0,8,0,3" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="FILENAME PREVIEW"/><TextBlock x:Name="NamePreview" FontWeight="SemiBold" AutomationProperties.Name="Filename preview"/>
    </StackPanel></Border>
    <Border Style="{StaticResource ShellPanel}" Padding="14"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="Color"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="CAMERA LUT"/><ComboBox x:Name="CameraCombo" DisplayMemberPath="Label" AutomationProperties.Name="Camera LUT policy" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="CREATIVE LUT"/><ComboBox x:Name="CreativeCombo" DisplayMemberPath="Label" AutomationProperties.Name="Creative LUT policy" SelectionChanged="Configuration_Changed"/></StackPanel></Grid></StackPanel></Border>
   </StackPanel>
   <StackPanel Grid.Column="2"><Border x:Name="FilesToExportPanel" Style="{StaticResource ShellPanel}" Padding="14" Margin="0,0,0,10"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FilesToExportHeading" FontSize="15" FontWeight="SemiBold"/><CheckBox x:Name="GlobalUseRangesCheck" Grid.Column="1" VerticalAlignment="Center" Content="Use In/Out points" IsThreeState="False" Checked="GlobalUseRanges_Changed" Unchecked="GlobalUseRanges_Changed" Indeterminate="GlobalUseRanges_Changed" AutomationProperties.Name="Use In and Out points for applicable files"/></Grid><ScrollViewer x:Name="FilesToExportScroll" Style="{StaticResource StableVerticalScrollViewer}" MaxHeight="220" Margin="0,9,0,0" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellDividerBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" KeyboardNavigation.DirectionalNavigation="Continue"><ItemsControl x:Name="FilesToExportItems" Background="{DynamicResource ShellSurfaceBrush}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="8,6" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellDividerBrush}" BorderThickness="0,0,0,1"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding SourceFileName}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding SourceFileName}"/><CheckBox x:Name="RangeCheck" Margin="0,2,0,0" Content="{Binding RangeText}" IsChecked="{Binding UseRange, Mode=OneWay}" IsEnabled="{Binding RangeControlEnabled}" Checked="RangeUse_Changed" Unchecked="RangeUse_Changed" AutomationProperties.Name="{Binding RangeAutomationName}"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding OutputText}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding OutputAutomationText}"/></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding HasRange}" Value="False"><Setter TargetName="RangeCheck" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border><Border Style="{StaticResource ShellPanel}" Padding="14"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="Export Settings"/>
    <Grid x:Name="PrimarySettings" Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource FieldLabel}" Text="Format"/><Button x:Name="FormatInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About output format" ToolTip="The container used for exported files. Same as Source preserves each input's compatible container."/></StackPanel><ComboBox x:Name="ContainerCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Output format" SelectionChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="1" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource FieldLabel}" Text="Video codec"/><Button x:Name="CodecInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About video codec" ToolTip="The video compression format used for export. Same as Source re-encodes using the source codec when supported."/></StackPanel><ComboBox x:Name="CodecCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Video codec" SelectionChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="2" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource FieldLabel}" Text="Resolution"/><Button x:Name="ResolutionInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About output resolution" ToolTip="Lower presets preserve aspect ratio at the selected height. 4K fits into and pads a 3840 × 2160 canvas."/></StackPanel><ComboBox x:Name="ResolutionCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Output resolution" SelectionChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="3" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource FieldLabel}" Text="Frame rate"/><Button x:Name="FrameRateInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About frame rate" ToolTip="Controls exported video cadence. Same as Source preserves the source frame rate while re-encoding."/></StackPanel><ComboBox x:Name="FrameRateCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Frame rate" SelectionChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="4" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource FieldLabel}" Text="Quality mode"/><Button x:Name="RateControlInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About quality mode" ToolTip="Chooses whether export is controlled by visual quality, variable bitrate, or constant bitrate."/></StackPanel><ComboBox x:Name="RateControlCombo" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Quality mode" SelectionChanged="Configuration_Changed"/>
     <Grid x:Name="QualityPrimaryLabel" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource FieldLabel}" Text="Quality / CQ"/><Button x:Name="QualityInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About constant quality" ToolTip="Controls Constant Quality encoding. Lower values prioritize higher visual quality and larger files; higher values produce smaller files with more compression."/></StackPanel><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource BoundedValueBox}" Margin="0,0,8,0"><TextBlock x:Name="QualityValue" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding Value, ElementName=QualitySlider, StringFormat={}{0:0}}" AutomationProperties.Name="Selected constant quality value"/></Border><Slider x:Name="QualitySlider" Grid.Column="1" Style="{StaticResource CqSliderStyle}" AutomationProperties.Name="Constant quality, 0 through 51" ValueChanged="Configuration_Changed"/></Grid></Grid>
     <StackPanel x:Name="TargetPrimaryLabel" Grid.Row="6" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource FieldLabel}" Text="Target bitrate"/><Button x:Name="TargetInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About target bitrate" ToolTip="The average video bitrate used by Variable Bitrate mode, in megabits per second."/></StackPanel><TextBox x:Name="TargetText" Grid.Row="6" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Target bitrate" TextChanged="Configuration_Changed"/>
     <StackPanel x:Name="MaxPrimaryLabel" Grid.Row="7" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource FieldLabel}" Text="Maximum bitrate"/><Button x:Name="MaxInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About maximum bitrate" ToolTip="The peak video bitrate allowed by Variable Bitrate mode, in megabits per second."/></StackPanel><TextBox x:Name="MaxText" Grid.Row="7" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Maximum bitrate" TextChanged="Configuration_Changed"/>
     <StackPanel x:Name="CbrPrimaryLabel" Grid.Row="8" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource FieldLabel}" Text="CBR bitrate"/><Button x:Name="CbrInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About constant bitrate" ToolTip="The fixed video bitrate used by Constant Bitrate mode, in megabits per second."/></StackPanel><TextBox x:Name="CbrText" Grid.Row="8" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Constant bitrate" TextChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="9" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource FieldLabel}" Text="Audio"/><Button x:Name="AudioInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About audio handling" ToolTip="Controls whether source audio is preserved, encoded as AAC, or omitted. Source audio uses AAC fallback when copy is incompatible."/></StackPanel><ComboBox x:Name="AudioCombo" Grid.Row="9" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Audio handling" SelectionChanged="Configuration_Changed"/>
     <StackPanel Grid.Row="10" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource FieldLabel}" Text="Encoder"/><Button x:Name="EncoderInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About encoder" ToolTip="Lightflow currently uses NVIDIA hardware encoding and verifies availability before Export."/></StackPanel><ComboBox x:Name="EncoderCombo" Grid.Row="10" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Encoder backend" IsEnabled="False"/>
    </Grid>
    <Border Margin="0,4,0,8" Padding="9,7" Background="{DynamicResource ShellRaisedBrush}" CornerRadius="5"><StackPanel><TextBlock x:Name="HardwareStatusHeading" FontWeight="SemiBold"/><TextBlock x:Name="EncoderDiagnostic" Margin="0,2,0,0" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border>
    <Expander x:Name="AdvancedExpander" Style="{StaticResource AdvancedDisclosure}" Expanded="Configuration_Changed" Collapsed="Configuration_Changed"><Border Padding="12" Background="Transparent" BorderBrush="{DynamicResource ShellDividerBrush}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><StackPanel Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource AdvancedLabel}" Text="NVENC PRESET"/><Button x:Name="PresetInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About NVENC preset" ToolTip="Controls the tradeoff between encoding speed and compression efficiency. Higher presets use more GPU time for better efficiency; P1 favors speed and P7 favors quality."/></StackPanel><ComboBox x:Name="PresetCombo" DisplayMemberPath="Label" AutomationProperties.Name="NVIDIA NVENC preset P1 through P7" SelectionChanged="Configuration_Changed"/><StackPanel Margin="0,8,0,0" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource AdvancedLabel}" Text="TUNE"/><Button x:Name="TuneInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About NVENC tune" ToolTip="Optimizes NVENC behavior for quality or latency-sensitive workloads."/></StackPanel><ComboBox x:Name="TuneCombo" DisplayMemberPath="Label" AutomationProperties.Name="Encoder tune" SelectionChanged="Configuration_Changed"/><StackPanel Margin="0,8,0,0" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource AdvancedLabel}" Text="MULTIPASS"/><Button x:Name="MultipassInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About multipass" ToolTip="Allows NVENC to analyze the video more than once to improve bitrate allocation and quality."/></StackPanel><ComboBox x:Name="MultipassCombo" DisplayMemberPath="Label" AutomationProperties.Name="Multipass mode" SelectionChanged="Configuration_Changed"/><StackPanel Margin="0,8,0,0" Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource AdvancedLabel}" Text="PIXEL FORMAT"/><Button x:Name="PixelFormatInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About pixel format" ToolTip="Controls output chroma sampling and bit depth. Some formats require HEVC."/></StackPanel><ComboBox x:Name="PixelFormatCombo" DisplayMemberPath="Label" AutomationProperties.Name="Pixel format" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><Grid x:Name="AqSettingLayout"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Style="{StaticResource LabelHelpRow}"><TextBlock Style="{StaticResource AdvancedLabel}" Text="AQ STRENGTH"/><Button x:Name="AqInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About adaptive quantization strength" ToolTip="Controls how strongly adaptive quantization redistributes quality across detailed and flat areas. Higher values apply the effect more aggressively."/><Border Style="{StaticResource BoundedValueBox}"><TextBlock x:Name="AqStrengthValue" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding Value, ElementName=AqStrengthSlider, StringFormat={}{0:0}}" AutomationProperties.Name="Selected adaptive quantization strength"/></Border></StackPanel><Grid x:Name="AqStrengthPanel" Grid.Row="1" Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="1"/><Slider x:Name="AqStrengthSlider" Grid.Column="1" Margin="7,0" Style="{StaticResource AqSliderStyle}" AutomationProperties.Name="Adaptive quantization strength, 1 through 15" ValueChanged="Configuration_Changed"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="15"/></Grid></Grid><StackPanel Margin="0,10,0,0" Style="{StaticResource LabelHelpRow}"><CheckBox x:Name="SpatialAqCheck" Content="Spatial AQ" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><Button x:Name="SpatialAqInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About spatial adaptive quantization" ToolTip="Adjusts compression within each frame to preserve visually important detail."/></StackPanel><StackPanel Margin="0,7,0,0" Style="{StaticResource LabelHelpRow}"><CheckBox x:Name="TemporalAqCheck" Content="Temporal AQ" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><Button x:Name="TemporalAqInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About temporal adaptive quantization" ToolTip="Adjusts compression across frames to preserve detail in changing areas over time."/></StackPanel><StackPanel Margin="0,7,0,0" Style="{StaticResource LabelHelpRow}"><CheckBox x:Name="DeinterlaceCheck" Content="Deinterlace" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><Button x:Name="DeinterlaceInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About deinterlacing" ToolTip="Converts interlaced source video to progressive output."/></StackPanel><StackPanel Margin="0,7,0,0" Style="{StaticResource LabelHelpRow}"><CheckBox x:Name="FastStartCheck" Content="Fast Start" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><Button x:Name="FastStartInfo" Style="{StaticResource InfoButton}" AutomationProperties.Name="About fast start" ToolTip="Moves MP4 metadata to the beginning of the file so playback can begin before the full file is downloaded."/></StackPanel></StackPanel></Grid></Border></Expander>
