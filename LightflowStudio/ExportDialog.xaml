<Window x:Class="LightflowStudio.ExportDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Export" Width="1040" Height="760" MinWidth="900" MinHeight="650"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource ShellCanvasBrush}"
 Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock FontSize="24" FontWeight="SemiBold" Text="Export"/><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Configure this export, then return immediately to your work."/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource ShellPanel}" Margin="0,0,0,12"><StackPanel>
     <TextBlock FontSize="15" FontWeight="SemiBold" Text="Destination"/>
     <TextBlock Margin="0,10,0,4" Foreground="{DynamicResource MutedTextBrush}" Text="OUTPUT FOLDER"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DestinationText" TextChanged="Configuration_Changed"/><Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="Browse_Click"/></Grid>
     <CheckBox x:Name="CreateSubfolderCheck" Margin="0,10,0,0" Content="Create subfolder" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/>
     <TextBox x:Name="SubfolderText" Margin="22,6,0,0" Text="Exports" TextChanged="Configuration_Changed"/>
     <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="EXAMPLE OUTPUT"/>
     <TextBlock x:Name="PathPreview" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Border Style="{StaticResource ShellPanel}" Margin="0,0,0,12"><StackPanel>
     <TextBlock FontSize="15" FontWeight="SemiBold" Text="File Naming"/>
     <ListBox x:Name="NamePartsList" Margin="0,10,0,0" MinHeight="72" DisplayMemberPath="Kind" SelectionChanged="NamePart_Selected"/>
     <WrapPanel Margin="0,8,0,0"><ComboBox x:Name="AddPartCombo" Width="150"/><Button Margin="6,0,0,0" Content="Add name part" Click="AddPart_Click"/><Button Margin="6,0,0,0" Content="Remove" Click="RemovePart_Click"/><Button Margin="6,0,0,0" Content="↑" ToolTip="Move selected name part earlier" Click="MoveUp_Click"/><Button Margin="4,0,0,0" Content="↓" ToolTip="Move selected name part later" Click="MoveDown_Click"/></WrapPanel>
     <TextBox x:Name="CustomTextBox" Margin="0,8,0,0" Visibility="Collapsed" TextChanged="CustomText_Changed"/>
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="SEPARATOR"/><ComboBox x:Name="SeparatorCombo" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="EXISTING OUTPUT"/><ComboBox x:Name="ExistingCombo" SelectionChanged="Configuration_Changed"><ComboBoxItem Content="Preserve / skip"/><ComboBoxItem Content="Overwrite"/></ComboBox></StackPanel></Grid>
     <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="FILENAME PREVIEW"/><TextBlock x:Name="NamePreview" Margin="0,4,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource ShellPanel}"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="Color"/>
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="CAMERA LUT"/><ComboBox x:Name="CameraCombo" DisplayMemberPath="Label" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="CREATIVE LUT"/><ComboBox x:Name="CreativeCombo" DisplayMemberPath="Label" SelectionChanged="Configuration_Changed"/></StackPanel></Grid>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource ShellPanel}"><StackPanel>
     <TextBlock FontSize="15" FontWeight="SemiBold" Text="Export Settings"/>
     <UniformGrid Columns="2" Margin="0,10,0,0"><StackPanel Margin="0,0,6,8"><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="FORMAT"/><ComboBox x:Name="ContainerCombo" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="VIDEO CODEC"/><ComboBox x:Name="CodecCombo" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Margin="0,0,6,8"><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="QUALITY MODE"/><ComboBox x:Name="RateControlCombo" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="RESOLUTION"/><ComboBox x:Name="ResolutionCombo" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Margin="0,0,6,8"><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="FRAME RATE"/><ComboBox x:Name="FrameRateCombo" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="AUDIO"/><ComboBox x:Name="AudioCombo" SelectionChanged="Configuration_Changed" ToolTip="Source audio is copied when compatible; otherwise Lightflow uses the configured AAC fallback."/></StackPanel><StackPanel Margin="0,0,6,8"><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="ENCODER"/><ComboBox x:Name="EncoderCombo" DisplayMemberPath="Backend" IsEnabled="False"/></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="PARALLEL EXPORTS"/><ComboBox x:Name="ParallelCombo" SelectionChanged="Configuration_Changed" ToolTip="Maximum number of files Lightflow exports simultaneously. This is not FFmpeg thread count."/></StackPanel></UniformGrid>
     <TextBlock x:Name="EncoderDiagnostic" Margin="0,2,0,8" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
     <Expander x:Name="AdvancedExpander" Header="Advanced" Expanded="Configuration_Changed" Collapsed="Configuration_Changed"><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Quality / CQ"/><TextBox x:Name="QualityText" TextChanged="Configuration_Changed"/><TextBlock Margin="0,8,0,0" Text="Target bitrate (Mbps)"/><TextBox x:Name="TargetText" TextChanged="Configuration_Changed"/><TextBlock Margin="0,8,0,0" Text="Maximum bitrate (Mbps)"/><TextBox x:Name="MaxText" TextChanged="Configuration_Changed"/><TextBlock Margin="0,8,0,0" Text="NVENC preset P1–P7"/><TextBox x:Name="PresetText" TextChanged="Configuration_Changed"/><TextBlock Margin="0,8,0,0" Text="AQ strength"/><TextBox x:Name="AqText" TextChanged="Configuration_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><ComboBox x:Name="TuneCombo" SelectionChanged="Configuration_Changed"/><ComboBox x:Name="MultipassCombo" Margin="0,8,0,0" SelectionChanged="Configuration_Changed"/><ComboBox x:Name="PixelFormatCombo" Margin="0,8,0,0" SelectionChanged="Configuration_Changed"/><CheckBox x:Name="SpatialAqCheck" Margin="0,10,0,0" Content="Spatial AQ" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><CheckBox x:Name="TemporalAqCheck" Margin="0,8,0,0" Content="Temporal AQ" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><CheckBox x:Name="DeinterlaceCheck" Margin="0,8,0,0" Content="Deinterlace" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><CheckBox x:Name="FastStartCheck" Margin="0,8,0,0" Content="Fast Start" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/></StackPanel></Grid></Expander>
    </StackPanel></Border>
    <Border Style="{StaticResource ShellPanel}" Margin="0,12,0,0"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="Preflight"/><TextBlock x:Name="PreflightText" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Estimated time: Estimate unavailable"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Width="92" Content="Cancel" IsCancel="True"/><Button x:Name="ExportButton" Width="108" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Content="Export" Click="Export_Click"/></StackPanel><TextBlock x:Name="QueueError" VerticalAlignment="Center" Foreground="#FFFF8A80" TextWrapping="Wrap"/></DockPanel>
 </Grid>
</Window>
