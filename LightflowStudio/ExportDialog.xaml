<Window x:Class="LightflowStudio.ExportDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Export" Width="1120" Height="800" MinWidth="940" MinHeight="680" WindowStartupLocation="CenterOwner" Background="{DynamicResource ShellCanvasBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="NamePartChip" TargetType="Border"><Setter Property="Background" Value="{DynamicResource ShellRaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ShellDividerBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,0,6,6"/></Style>
  <Style x:Key="ChipButton" TargetType="Button"><Setter Property="MinWidth" Value="22"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="3,0"/><Setter Property="Margin" Value="2,3,0,0"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource ShellDividerBrush}"/></Style>
  <Style x:Key="AdvancedToggle" TargetType="ToggleButton"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource ShellRaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ShellDividerBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="10,7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ShellPanelBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ShellFocusBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ShellFocusBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ShellSurfaceBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ShellDividerBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="AdvancedDisclosure" TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton Style="{StaticResource AdvancedToggle}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Advanced export settings"><Grid><TextBlock x:Name="DisclosureIcon" Text="▸"/><TextBlock Margin="20,0,0,0" Text="Advanced" FontWeight="SemiBold"/></Grid></ToggleButton><ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" ContentSource="Content"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="DisclosureIcon" Property="Text" Value="▾"/><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="AdvancedLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource NavigationTextBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock FontSize="23" FontWeight="SemiBold" Text="Export"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Configure this export, then return immediately to your work."/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel>
    <Border Style="{StaticResource ShellPanel}" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="Destination"/><TextBlock Margin="0,8,0,4" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="OUTPUT FOLDER"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DestinationText" AutomationProperties.Name="Output folder" TextChanged="Configuration_Changed"/><Button Grid.Column="1" Margin="7,0,0,0" Content="Browse…" Click="Browse_Click" AutomationProperties.Name="Browse for output folder"/></Grid><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="CreateSubfolderCheck" VerticalAlignment="Center" Content="Create subfolder" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><TextBox x:Name="SubfolderText" Grid.Column="1" Margin="10,0,0,0" Text="Exports" AutomationProperties.Name="Export subfolder name" TextChanged="Configuration_Changed"/></Grid><Border x:Name="OutputExampleBorder" Margin="0,8,0,0" Padding="8,5" Background="{DynamicResource ShellSurfaceBrush}" CornerRadius="4"><DockPanel><TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" Foreground="{DynamicResource MutedTextBrush}" Text="Output example"/><TextBlock x:Name="OutputFilenamePreview" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Margin="5,0" Foreground="{DynamicResource MutedTextBrush}" Text="→"/><TextBlock x:Name="PathPreview" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.Name="Output example folder"/></DockPanel></Border></StackPanel></Border>
    <Border Style="{StaticResource ShellPanel}" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="File Naming"/>
     <WrapPanel x:Name="FilenameComposer" Margin="0,8,0,0"><ItemsControl x:Name="NamePartsComposer"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource NamePartChip}" AllowDrop="True" Drop="NamePart_Drop" PreviewMouseLeftButtonDown="NamePart_MouseDown" PreviewMouseMove="NamePart_MouseMove" AutomationProperties.Name="{Binding AutomationName}"><StackPanel><TextBlock x:Name="PartLabel" HorizontalAlignment="Center" Text="{Binding Label}"/><TextBox x:Name="CustomPartText" Width="95" Text="{Binding Part.Text, Mode=OneWay}" Visibility="Collapsed" TextChanged="CustomPartText_Changed" AutomationProperties.Name="Custom text name part value"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource ChipButton}" Content="◀" Click="MovePartEarlier_Click" AutomationProperties.Name="{Binding MoveEarlierAutomationName}"/><Button Style="{StaticResource ChipButton}" Content="▶" Click="MovePartLater_Click" AutomationProperties.Name="{Binding MoveLaterAutomationName}"/><Button Style="{StaticResource ChipButton}" Content="×" Click="RemovePart_Click" AutomationProperties.Name="{Binding RemoveAutomationName}"/></StackPanel></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsCustomText}" Value="True"><Setter TargetName="PartLabel" Property="Visibility" Value="Collapsed"/><Setter TargetName="CustomPartText" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Margin="0,0,0,6" Padding="4,5" VerticalAlignment="Top"><TextBlock x:Name="ExtensionPreview" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Output filename extension"/></Border></WrapPanel>
     <StackPanel Orientation="Horizontal"><ComboBox x:Name="AddPartCombo" Width="175" Height="30" DisplayMemberPath="Label" AutomationProperties.Name="Name part to add"/><Button Height="30" Margin="6,0,0,0" Padding="12,0" Content="+ Add" Click="AddPart_Click" AutomationProperties.Name="Add name part"/></StackPanel>
     <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="SEPARATOR"/><ComboBox x:Name="SeparatorCombo" DisplayMemberPath="Label" AutomationProperties.Name="Filename separator" SelectionChanged="Configuration_Changed"/></StackPanel><CheckBox x:Name="OverwriteExistingCheck" Grid.Column="1" Margin="14,17,0,0" VerticalAlignment="Top" Content="Overwrite existing files" AutomationProperties.Name="Overwrite existing files" Checked="Configuration_Changed" Unchecked="Configuration_Changed"/></Grid>
     <TextBlock Margin="0,8,0,3" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="FILENAME PREVIEW"/><TextBlock x:Name="NamePreview" FontWeight="SemiBold" AutomationProperties.Name="Filename preview"/>
    </StackPanel></Border>
    <Border Style="{StaticResource ShellPanel}" Padding="14"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="Color"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="CAMERA LUT"/><ComboBox x:Name="CameraCombo" DisplayMemberPath="Label" AutomationProperties.Name="Camera LUT policy" SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="CREATIVE LUT"/><ComboBox x:Name="CreativeCombo" DisplayMemberPath="Label" AutomationProperties.Name="Creative LUT policy" SelectionChanged="Configuration_Changed"/></StackPanel></Grid></StackPanel></Border>
   </StackPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Border Style="{StaticResource ShellPanel}" Padding="14"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="Export Settings"/>
    <Grid x:Name="PrimarySettings" Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Format" ToolTip="The container used for exported files. Same as Source preserves each input's compatible container."/><ComboBox x:Name="ContainerCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Output format" ToolTip="The container used for exported files. Same as Source preserves each input's compatible container." SelectionChanged="Configuration_Changed"/>
     <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Video codec" ToolTip="The video compression format used for export. Same as Source re-encodes using the source codec when supported."/><ComboBox x:Name="CodecCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Video codec" ToolTip="The video compression format used for export. Same as Source re-encodes using the source codec when supported." SelectionChanged="Configuration_Changed"/>
     <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Resolution" ToolTip="Controls exported frame dimensions. Same as Source preserves the source resolution."/><ComboBox x:Name="ResolutionCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Output resolution" ToolTip="Controls exported frame dimensions. Same as Source preserves the source resolution." SelectionChanged="Configuration_Changed"/>
     <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Frame rate" ToolTip="Controls exported video cadence. Same as Source preserves the source frame rate while re-encoding."/><ComboBox x:Name="FrameRateCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Frame rate" ToolTip="Controls exported video cadence. Same as Source preserves the source frame rate while re-encoding." SelectionChanged="Configuration_Changed"/>
     <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Quality mode" ToolTip="Chooses whether export is controlled by visual quality, variable bitrate, or constant bitrate."/><ComboBox x:Name="RateControlCombo" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Quality mode" ToolTip="Chooses whether export is controlled by visual quality, variable bitrate, or constant bitrate." SelectionChanged="Configuration_Changed"/>
     <TextBlock x:Name="QualityPrimaryLabel" Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Quality / CQ" ToolTip="Lower CQ values preserve more visual detail and produce larger files."/><TextBox x:Name="QualityText" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Constant quality value" ToolTip="Lower CQ values preserve more visual detail and produce larger files." TextChanged="Configuration_Changed"/>
     <TextBlock x:Name="TargetPrimaryLabel" Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Target bitrate" ToolTip="The average video bitrate used by Variable Bitrate mode, in megabits per second."/><TextBox x:Name="TargetText" Grid.Row="6" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Target bitrate" ToolTip="The average video bitrate used by Variable Bitrate mode, in megabits per second." TextChanged="Configuration_Changed"/>
     <TextBlock x:Name="MaxPrimaryLabel" Grid.Row="7" Style="{StaticResource FieldLabel}" Text="Maximum bitrate" ToolTip="The peak video bitrate allowed by Variable Bitrate mode, in megabits per second."/><TextBox x:Name="MaxText" Grid.Row="7" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Maximum bitrate" ToolTip="The peak video bitrate allowed by Variable Bitrate mode, in megabits per second." TextChanged="Configuration_Changed"/>
     <TextBlock x:Name="CbrPrimaryLabel" Grid.Row="8" Style="{StaticResource FieldLabel}" Text="Bitrate" ToolTip="The fixed video bitrate used by Constant Bitrate mode, in megabits per second."/><TextBox x:Name="CbrText" Grid.Row="8" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Constant bitrate" ToolTip="The fixed video bitrate used by Constant Bitrate mode, in megabits per second." TextChanged="Configuration_Changed"/>
     <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="Audio" ToolTip="Controls whether source audio is preserved, encoded as AAC, or omitted."/><ComboBox x:Name="AudioCombo" Grid.Row="9" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Audio handling" ToolTip="Controls whether source audio is preserved, encoded as AAC, or omitted. Source audio uses AAC fallback when copy is incompatible." SelectionChanged="Configuration_Changed"/>
     <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="Encoder" ToolTip="Lightflow currently uses NVIDIA hardware encoding and verifies availability before Export."/><ComboBox x:Name="EncoderCombo" Grid.Row="10" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" AutomationProperties.Name="Encoder backend" ToolTip="Lightflow currently uses NVIDIA hardware encoding and verifies availability before Export." IsEnabled="False"/>
     <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="Parallel exports" ToolTip="Maximum number of files Lightflow exports simultaneously. This is not FFmpeg thread count."/><ComboBox x:Name="ParallelCombo" Grid.Row="11" Grid.Column="1" AutomationProperties.Name="Parallel exports" ToolTip="Maximum number of files Lightflow exports simultaneously. This is not FFmpeg thread count." SelectionChanged="Configuration_Changed"/>
    </Grid>
    <Border Margin="0,4,0,8" Padding="9,7" Background="{DynamicResource ShellRaisedBrush}" CornerRadius="5"><StackPanel><TextBlock x:Name="HardwareStatusHeading" FontWeight="SemiBold"/><TextBlock x:Name="EncoderDiagnostic" Margin="0,2,0,0" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border>
    <Expander x:Name="AdvancedExpander" Style="{StaticResource AdvancedDisclosure}" Expanded="Configuration_Changed" Collapsed="Configuration_Changed"><Border Margin="0,7,0,0" Padding="12" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellDividerBrush}" BorderThickness="1" CornerRadius="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource AdvancedLabel}" Text="NVENC PRESET (P1–P7)" ToolTip="Balances encoding speed and compression efficiency; higher presets favor quality."/><TextBox x:Name="PresetText" AutomationProperties.Name="NVIDIA NVENC preset" ToolTip="Balances encoding speed and compression efficiency; higher presets favor quality." TextChanged="Configuration_Changed"/><TextBlock Style="{StaticResource AdvancedLabel}" Margin="0,8,0,4" Text="TUNE"/><ComboBox x:Name="TuneCombo" DisplayMemberPath="Label" AutomationProperties.Name="Encoder tune" ToolTip="Optimizes the encoder for quality or lower playback latency." SelectionChanged="Configuration_Changed"/><TextBlock Style="{StaticResource AdvancedLabel}" Margin="0,8,0,4" Text="MULTIPASS"/><ComboBox x:Name="MultipassCombo" DisplayMemberPath="Label" AutomationProperties.Name="Multipass mode" ToolTip="Allows NVENC to analyze additional detail before final encoding." SelectionChanged="Configuration_Changed"/><TextBlock Style="{StaticResource AdvancedLabel}" Margin="0,8,0,4" Text="PIXEL FORMAT"/><ComboBox x:Name="PixelFormatCombo" DisplayMemberPath="Label" AutomationProperties.Name="Pixel format" ToolTip="Controls output chroma sampling and bit depth." SelectionChanged="Configuration_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Style="{StaticResource AdvancedLabel}" Text="AQ STRENGTH"/><TextBox x:Name="AqText" AutomationProperties.Name="Adaptive quantization strength" ToolTip="Controls how strongly adaptive quantization redistributes detail." TextChanged="Configuration_Changed"/><CheckBox x:Name="SpatialAqCheck" Margin="0,10,0,0" Content="Spatial AQ" ToolTip="Redistributes bitrate between regions within each frame." Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><CheckBox x:Name="TemporalAqCheck" Margin="0,7,0,0" Content="Temporal AQ" ToolTip="Redistributes bitrate across frames over time." Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><CheckBox x:Name="DeinterlaceCheck" Margin="0,7,0,0" Content="Deinterlace" ToolTip="Converts interlaced source video to progressive output." Checked="Configuration_Changed" Unchecked="Configuration_Changed"/><CheckBox x:Name="FastStartCheck" Margin="0,7,0,0" Content="Fast Start" ToolTip="Moves MP4/MOV playback metadata to the start of the file for faster streaming." Checked="Configuration_Changed" Unchecked="Configuration_Changed"/></StackPanel></Grid></Border></Expander>
   </StackPanel></Border></StackPanel></ScrollViewer>
  </Grid>
  <Border x:Name="ValidationBorder" Grid.Row="2" Margin="0,10,0,0" Padding="10,7" Background="{DynamicResource ShellRaisedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="5" Visibility="Collapsed"><TextBlock x:Name="ValidationText" TextWrapping="Wrap"/></Border>
  <DockPanel Grid.Row="3" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Width="92" Content="Cancel" IsCancel="True"/><Button x:Name="ExportButton" Width="108" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Content="Export" Click="Export_Click"/></StackPanel><TextBlock x:Name="QueueError" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#FFFF8A80" TextWrapping="Wrap"/></DockPanel>
 </Grid>
</Window>
