  <Style x:Key="InfoHelpButtonStyle" TargetType="Button"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-2"/></Setter.Value></Setter><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Content" Value="ⓘ"/><Setter Property="Focusable" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="InfoChrome" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter TargetName="InfoChrome" Property="BorderBrush" Value="{DynamicResource ShellFocusBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource ShellFocusBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><EventSetter Event="GotKeyboardFocus" Handler="InfoButton_GotKeyboardFocus"/><EventSetter Event="LostKeyboardFocus" Handler="InfoButton_LostKeyboardFocus"/></Style>
