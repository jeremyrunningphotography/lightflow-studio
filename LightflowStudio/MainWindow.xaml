       <ScrollViewer x:Name="SettingsStoragePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Storage settings page"><StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource SectionTitle}" FontSize="20" Text="Storage"/><TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Manage durable Catalog data, rebuildable Previews, and the locations that give media a stable identity."/>
        <Border Style="{StaticResource SettingsSectionStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Lightflow Storage"/>
         <Border Style="{StaticResource SettingsInsetPanelStyle}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Change…" AutomationProperties.Name="Change Catalog location" Click="ChangeCatalogLocation_Click"/><StackPanel><TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="Catalog Location"/><TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="0,4,16,0" Text="Important Lightflow library data. Changing this location performs a protected migration and keeps the original Catalog. The live Catalog must remain on a local drive."/></StackPanel></DockPanel><TextBox x:Name="SettingsCatalogDirectory" Style="{StaticResource SettingsPathTextBoxStyle}" Margin="0,8,0,0" IsReadOnly="True" AutomationProperties.Name="Catalog location"/></StackPanel></Border>
         <Border Style="{StaticResource SettingsInsetPanelStyle}"><StackPanel><DockPanel><Button x:Name="ChangePreviewsLocationButton" DockPanel.Dock="Right" Content="Change…" AutomationProperties.Name="Change Previews location" Click="ChangePreviewsLocation_Click"/><StackPanel><TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="Previews Location"/><TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="0,4,16,0" Text="Rebuildable media that can use significant disk space and may live on another drive."/></StackPanel></DockPanel><TextBox x:Name="SettingsPreviewsDirectory" Style="{StaticResource SettingsPathTextBoxStyle}" Margin="0,8,0,0" IsReadOnly="True" AutomationProperties.Name="Previews location"/>
