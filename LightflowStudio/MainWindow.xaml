                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ViewMode}" Value="{x:Static local:BrowserViewMode.Hybrid}"/><Condition Binding="{Binding HasUserAuthoredState}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel Orientation="Horizontal">
                     <ContentPresenter Style="{StaticResource BrowserStateIconItemStyle}" ContentTemplate="{StaticResource BrowserReviewRangeIcon}" Visibility="{Binding HasReviewRange, Converter={StaticResource BoolToVisibility}}"/>
                     <ContentPresenter Style="{StaticResource BrowserStateIconItemStyle}" ContentTemplate="{StaticResource BrowserSubclipsIcon}" Visibility="{Binding HasSubclips, Converter={StaticResource BoolToVisibility}}"/>
                     <ContentPresenter Style="{StaticResource BrowserStateIconItemStyle}" ContentTemplate="{StaticResource BrowserColorIcon}" Visibility="{Binding HasColorState, Converter={StaticResource BoolToVisibility}}"/>
