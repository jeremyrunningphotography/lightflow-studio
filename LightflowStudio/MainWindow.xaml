         <ListBoxItem Tag="Storage" AutomationProperties.Name="Storage settings"><StackPanel><TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="Storage"/><TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="Catalog and Previews"/></StackPanel></ListBoxItem>
