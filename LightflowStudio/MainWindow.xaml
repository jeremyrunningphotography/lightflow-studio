<Window x:Class="LightflowStudio.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:LightflowStudio"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 Title="Lightflow Studio" Icon="Assets/Branding/LightflowStudio.ico"
 Height="900" Width="1440" MinHeight="720" MinWidth="1120" WindowStartupLocation="CenterScreen"
 Closing="Window_Closing" PreviewKeyDown="MainWindow_PreviewKeyDown" PreviewKeyUp="MainWindow_PreviewKeyUp">
 <Window.Resources>
  <sys:Double x:Key="BrowserRow2ControlHeight">34</sys:Double>
  <sys:Double x:Key="JobsToolbarControlHeight">34</sys:Double>
  <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
  <local:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibility"/>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

  <!-- Settings is a lightweight utility, but its content needs a stable pattern that can grow without
       returning to one long configuration wall. These resources deliberately stay scoped to MainWindow:
       they define category navigation and preference-section presentation, not a second app-wide UI kit. -->
  <Style x:Key="SettingsCategoryItemStyle" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,1"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="11,9">
     <Grid><Border x:Name="Rail" Width="3" HorizontalAlignment="Left" Margin="-11,-3,0,-3" CornerRadius="2" Background="{StaticResource ShellFocusBrush}" Visibility="Collapsed"/><ContentPresenter/></Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellRaisedBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellDividerBrush}"/><Setter TargetName="Rail" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsSectionStyle" TargetType="Border" BasedOn="{StaticResource Card}">
   <Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="SettingsInsetPanelStyle" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource ShellCanvasBrush}"/><Setter Property="BorderBrush" Value="{StaticResource ShellDividerBrush}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,6,0,0"/>
  </Style>
  <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,10"/>
  </Style>
  <Style x:Key="SettingsPathTextBoxStyle" TargetType="TextBox">
   <Setter Property="MinWidth" Value="260"/><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
  </Style>

  <Style x:Key="JobsRowHeaderButtonStyle" TargetType="Button">
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Full Jobs owns conventional ListBox selection semantics, but supplies its own container chrome so
       WPF's system HighlightBrush never leaks into Lightflow. The persistent left rail is the non-color
       selection cue; the thicker outer outline is reserved for keyboard focus. -->
  <Style x:Key="JobsListItemStyle" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="0,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True"><Grid><Border x:Name="SelectionRail" Width="3" HorizontalAlignment="Left" Margin="0,5" CornerRadius="1.5" Background="{StaticResource ShellFocusBrush}" Visibility="Collapsed"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Grid></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellRaisedBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellDividerBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellDividerBrush}"/><Setter TargetName="SelectionRail" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Shared dark "chip" chrome for every standalone Browser toolbar control (the search field, Sort, and
       the quick-filter segmented group) so the row reads as one purpose-designed toolbar rather than a row
       of default form controls with their own mismatched borders. -->
  <Style x:Key="BrowserToolbarChipStyle" TargetType="Border">
   <Setter Property="Height" Value="{StaticResource BrowserRow2ControlHeight}"/>
   <Setter Property="Background" Value="{StaticResource ShellSurfaceBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ShellDividerBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="6"/>
  </Style>

  <!-- Standalone dark toggle chip — Filter ▾. Checked (popup open) uses the same restrained
       selection/focus accent already used for the quick-filter segments and the grid's own tile selection,
       rather than a bright default ToggleButton chrome. -->
  <Style x:Key="BrowserToolbarToggleButtonStyle" TargetType="ToggleButton">
   <Setter Property="Height" Value="{StaticResource BrowserRow2ControlHeight}"/>
   <Setter Property="Padding" Value="6,4"/>
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Chrome" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellDividerBrush}"
       BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/>
        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- #124 (revised): Include Subfolders lives in the media toolbar, immediately before the All/Images/RAW/Video
       group — scope narrows first, then the media-type controls narrow further, so reading order matches
       that pipeline. It keeps its own style rather than reusing BrowserToolbarToggleButtonStyle (Filter ▾'s
       chip) or BrowserQuickFilterSegmentStyle (the segmented group), so it never reads as a filter facet or
       as part of that segmented control, even though all three share the restrained checked-state accent
       already used throughout the Browser. The glyph shares the Locations tree's outline/filled folder
       vocabulary (see the HierarchicalDataTemplate below and MainWindow.SyncBrowserTreeRecursiveIcon): an
       outline folder (U+E8B7, already rendering elsewhere in this file) while unchecked, switching to a
       genuinely solid folder silhouette while checked. Hands-on testing found every available Segoe Fluent
       Icons/MDL2 Assets folder glyph (including U+E838, tried first) still read as an "open" folder rather
       than a filled one, so the filled state is a small hand-authored Path silhouette instead — a plain
       straight-edged tab-plus-body outline (no arcs, so its rendering can't depend on font/curve fidelity),
       sized and centered to match the outline glyph's footprint so switching states never shifts the
       "Subfolders" label. The label already names the operation, so the glyph itself only needs to read as
       on/off, not encode hierarchy on its own. -->
  <Style x:Key="BrowserScopeToggleButtonStyle" TargetType="ToggleButton">
   <Setter Property="Padding" Value="5,4"/>
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Chrome" Background="Transparent" BorderBrush="{StaticResource ShellDividerBrush}"
       BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <StackPanel Orientation="Horizontal">
        <Grid Width="16" Height="13" VerticalAlignment="Center">
         <TextBlock x:Name="ScopeGlyphOutline" HorizontalAlignment="Center" VerticalAlignment="Center"
          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Text="&#xE8B7;"/>
         <Path x:Name="ScopeGlyphFilled" Visibility="Collapsed" Fill="{StaticResource MutedTextBrush}"
          Stretch="Uniform" Width="15" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
          Data="M1,2 L6,2 L7.5,4 L15,4 L15,12 L1,12 Z"/>
        </Grid>
        <TextBlock x:Name="ScopeLabel" Margin="6,0,0,0" VerticalAlignment="Center" Text="Subfolders"/>
       </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/>
        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter TargetName="ScopeGlyphOutline" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="ScopeGlyphFilled" Property="Visibility" Value="Visible"/>
        <!-- Same accent this style already uses for its own checked-state Chrome border, so the active
             toolbar icon and filled recursive tree icons read as one coherent Lightflow accent language
             rather than the tree's own separate folder color. -->
        <Setter TargetName="ScopeGlyphFilled" Property="Fill" Value="{StaticResource ShellFocusBrush}"/>
       </Trigger>
       <Trigger Property="Tag" Value="Compact"><Setter TargetName="ScopeLabel" Property="Visibility" Value="Collapsed"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- One segment of the All/Images/RAW/Video group. Segments share one BrowserToolbarChipStyle outer
       Border (which clips their square corners into its own rounded shape) and divide with a thin right
       border rather than each carrying its own chip chrome, so the four read as one control. -->
  <Style x:Key="BrowserQuickFilterSegmentStyle" TargetType="ToggleButton">
   <Setter Property="Height" Value="{StaticResource BrowserRow2ControlHeight}"/>
   <Setter Property="Padding" Value="6,4"/>
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="BorderBrush" Value="{StaticResource ShellDividerBrush}"/>
   <Setter Property="BorderThickness" Value="0,0,1,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Chrome" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
       <Grid>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!-- Restrained accent: a thin underline rather than a full bright fill, matching the rest of
             Lightflow's "selected = dark tint + accent line/border" convention. -->
        <Border x:Name="AccentBar" Height="2" VerticalAlignment="Bottom" Background="{StaticResource ShellFocusBrush}" Visibility="Collapsed"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellRaisedBrush}"/></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/>
        <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="BrowserSelectionActionButtonStyle" TargetType="Button">
   <Setter Property="Height" Value="{StaticResource BrowserRow2ControlHeight}"/>
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="5,3"/>
   <Setter Property="Margin" Value="1,0"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellRaisedBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="JobsToolbarTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Height" Value="{StaticResource JobsToolbarControlHeight}"/><Setter Property="Margin" Value="0"/>
  </Style>
  <Style x:Key="JobsToolbarComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <Setter Property="Height" Value="{StaticResource JobsToolbarControlHeight}"/><Setter Property="Margin" Value="0"/>
  </Style>
  <Style x:Key="JobsToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Height" Value="{StaticResource JobsToolbarControlHeight}"/><Setter Property="Margin" Value="0"/>
  </Style>
  <Style x:Key="JobsHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Height" Value="{StaticResource JobsToolbarControlHeight}"/>
  </Style>
  <Style x:Key="JobsHeaderDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButton}">
   <Setter Property="Height" Value="{StaticResource JobsToolbarControlHeight}"/>
  </Style>

  <Style x:Key="BrowserExportActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BrowserSelectionActionButtonStyle}">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="{StaticResource ShellSurfaceBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/>
  </Style>

  <Style x:Key="BrowserSelectionLutComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <Setter Property="Height" Value="{StaticResource BrowserRow2ControlHeight}"/>
   <Setter Property="Width" Value="150"/>
   <Setter Property="Padding" Value="4,2"/>
   <Setter Property="Margin" Value="2,0"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="ItemTemplate">
    <Setter.Value><DataTemplate><TextBlock MaxWidth="280" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value>
   </Setter>
  </Style>

  <!-- #161: shared resolution-independent Browser state vocabulary, reused by Info and Hybrid. -->
  <DataTemplate x:Key="BrowserReviewRangeIcon">
   <Grid Width="20" Height="16" ToolTip="In/Out Range" AutomationProperties.Name="In/Out Range">
    <Path Stroke="#FF55D878" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
     Data="M2,3 L2,13 M2,8 L18,8 M18,3 L18,13"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="BrowserSubclipsIcon">
   <Grid Width="20" Height="16" ToolTip="Saved Subclips" AutomationProperties.Name="Saved Subclips">
    <Path Stroke="#FFFF8A1F" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
     Data="M3,3 L15,3 M6,8 L18,8 M3,13 L15,13"/>
    <Ellipse Width="2.5" Height="2.5" Margin="13.5,0,0,11" Fill="#FFFF8A1F"/>
    <Ellipse Width="2.5" Height="2.5" Margin="16.5,5,0,6" Fill="#FFFF8A1F"/>
    <Ellipse Width="2.5" Height="2.5" Margin="13.5,10,0,1" Fill="#FFFF8A1F"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="BrowserColorIcon">
   <Grid Width="18" Height="18" ToolTip="Color Applied" AutomationProperties.Name="Color Applied">
    <Grid Width="15" Height="15">
     <Grid.Clip><EllipseGeometry Center="7.5,7.5" RadiusX="7.5" RadiusY="7.5"/></Grid.Clip>
     <Path Fill="#E85D5D" Data="M7.5,7.5 L0,0 L7.5,0 Z"/><Path Fill="#F2A84B" Data="M7.5,7.5 L7.5,0 L15,0 L15,7.5 Z"/>
     <Path Fill="#E6D85A" Data="M7.5,7.5 L15,7.5 L15,15 L7.5,15 Z"/><Path Fill="#55B97A" Data="M7.5,7.5 L7.5,15 L0,15 Z"/>
     <Path Fill="#4E9ED8" Data="M7.5,7.5 L0,15 L0,7.5 Z"/><Path Fill="#A56BD5" Data="M7.5,7.5 L0,7.5 L0,0 Z"/>
     <Ellipse Width="7" Height="7" Fill="#20252C" Stroke="#D9FFFFFF" StrokeThickness="0.8"/>
    </Grid>
   </Grid>
  </DataTemplate>
  <Style x:Key="BrowserStateIconItemStyle" TargetType="ContentPresenter">
   <Setter Property="Margin" Value="{DynamicResource BrowserStateIconSpacing}"/>
  </Style>

  <Style x:Key="BrowserViewModeButtonStyle" TargetType="ToggleButton">
   <Setter Property="Width" Value="27"/><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="4"/>
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellRaisedBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/><Setter Property="Foreground" Value="{StaticResource ShellFocusBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- #125: compact hit area for the thumbnail-size slider's track, mirroring TrimEditorWindow's
       PlaybackTimelineHitArea — invisible, just enlarges the click target beyond the thin track itself. -->
  <Style x:Key="BrowserThumbnailSizeSliderHitArea" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- #125: a small, notched (4-position, snap-to-tick) slider — deliberately lightweight/media-focused
       rather than a standard form-control Slider, matching the status bar's restrained, subdued treatment. -->
  <Style x:Key="BrowserThumbnailSizeSliderStyle" TargetType="Slider">
   <Setter Property="Width" Value="64"/>
   <Setter Property="Height" Value="20"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid VerticalAlignment="Center" Height="20">
       <Border Height="3" VerticalAlignment="Center" Background="{StaticResource ShellDividerBrush}" CornerRadius="1.5"/>
       <!-- Decorative notch marks, one per BrowserGridLayout.ThumbnailSizes entry; purely visual (the real
            discrete stops come from IsSnapToTickEnabled/TickFrequency on the Slider itself), so a minor
            approximation versus the thumb's exact travel positions is acceptable. -->
       <UniformGrid Columns="6" VerticalAlignment="Center" Height="4" IsHitTestVisible="False">
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource ShellDividerBrush}"/>
       </UniformGrid>
       <Track x:Name="PART_Track" VerticalAlignment="Center">
        <Track.DecreaseRepeatButton>
         <RepeatButton Style="{StaticResource BrowserThumbnailSizeSliderHitArea}" Command="{x:Static Slider.DecreaseLarge}"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb Width="11" Height="11" Focusable="False">
          <Thumb.Template>
           <ControlTemplate TargetType="Thumb">
            <Ellipse x:Name="Knob" Fill="{StaticResource MutedTextBrush}" Stroke="{StaticResource ShellCanvasBrush}" StrokeThickness="1.5"/>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{StaticResource TextBrush}"/></Trigger>
             <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{StaticResource ShellFocusBrush}"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton Style="{StaticResource BrowserThumbnailSizeSliderHitArea}" Command="{x:Static Slider.IncreaseLarge}"/>
        </Track.IncreaseRepeatButton>
       </Track>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- #125: the small/large glyphs flanking the thumbnail-size slider are real, keyboard-reachable Buttons
       (one step per click, see MainWindow.ApplyBrowserThumbnailSize/StepLevel) rather than a decorative
       TextBlock with raw mouse handling. At rest they look identical to the plain glyph they replaced;
       hover/press/focus/disabled are the only visual difference, kept restrained to match this status bar's
       subdued language rather than reading as a conventional button. -->
  <Style x:Key="BrowserThumbnailSizeStepButtonStyle" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="3"/>
   <Setter Property="Margin" Value="0"/>
   <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
       CornerRadius="4" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellRaisedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ShellFocusBrush}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{StaticResource WindowBrush}">
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

