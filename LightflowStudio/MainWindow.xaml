       <ScrollViewer x:Name="SettingsExportPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Export settings page"><StackPanel MaxWidth="900" HorizontalAlignment="Left">
