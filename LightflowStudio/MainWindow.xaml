      <Grid Grid.Column="2">
       <ScrollViewer x:Name="SettingsGeneralPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="General settings page"><StackPanel MaxWidth="900" HorizontalAlignment="Left">
