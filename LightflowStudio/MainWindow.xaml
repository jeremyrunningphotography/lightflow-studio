  </TabControl>
  <StackPanel Grid.Column="0" x:Name="RightDrawerPullSwitcher" HorizontalAlignment="Right" VerticalAlignment="Center">
   <Button x:Name="JobsDrawerPullButton" Style="{StaticResource DrawerPullButton}" Tag="Idle" ToolTip="Open Jobs drawer" AutomationProperties.Name="Open Jobs drawer" Click="JobsDrawerPull_Click"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="JobsDrawerPullChevron" HorizontalAlignment="Center" FontSize="15" Text="‹"/><TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="10" Text="Jobs"><TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform></TextBlock><TextBlock x:Name="JobsDrawerPullCount" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10" Visibility="Collapsed"/></StackPanel></Button>
   <Button x:Name="SubclipsDrawerPullButton" Style="{StaticResource DrawerPullButton}" Margin="0,8,0,0" Visibility="Collapsed" ToolTip="Open Subclips drawer" AutomationProperties.Name="Open Subclips drawer" Click="SubclipsDrawerPull_Click"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="SubclipsDrawerPullChevron" HorizontalAlignment="Center" FontSize="15" Text="‹"/><TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="10" Text="Subclips"><TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform></TextBlock></StackPanel></Button>
  </StackPanel>
  <GridSplitter Grid.Column="1" x:Name="JobsDrawerSplitter" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeWE" Visibility="Collapsed" ToolTip="Drag to resize Jobs drawer" AutomationProperties.Name="Resize Jobs drawer"><GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="Transparent"/></ControlTemplate></GridSplitter.Template></GridSplitter>
  <Border Grid.Column="2" x:Name="JobsDrawer" Style="{StaticResource DrawerBody}" MinWidth="340" MaxWidth="620" ClipToBounds="True" Visibility="Collapsed">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Style="{StaticResource DrawerHeaderText}" Margin="0,0,0,9" Text="JOBS" ToolTip="Current and recent exports" AutomationProperties.HelpText="Current and recent exports"/>
    <Grid Grid.Row="1" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Active exports" ToolTip="Controls how many exports may execute simultaneously" AutomationProperties.HelpText="Controls how many exports may execute simultaneously"/>
     <ComboBox Grid.Column="1" x:Name="MaximumExportsCombo" Margin="8,0,0,0" Width="58" ToolTip="Maximum exports that may execute simultaneously" AutomationProperties.Name="Active exports" AutomationProperties.HelpText="Controls how many exports may execute simultaneously" SelectedValuePath="Content" SelectionChanged="MaximumExports_SelectionChanged">
      <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/>
     </ComboBox><Button Grid.Column="2" x:Name="JobsQueueGateButton" Margin="8,0,0,0" Padding="7,3" MinWidth="88" Content="Pause Queue" ToolTip="Hold queued Jobs; running exports continue" AutomationProperties.Name="Pause Queue" AutomationProperties.HelpText="Hold queued Jobs before they start. Running exports continue." Click="JobsQueueGate_Click"/><Button Grid.Column="3" x:Name="JobsCancelAllButton" Margin="8,0,0,0" Padding="7,3" MinWidth="65" Style="{StaticResource DangerButton}" Content="Clear all" IsEnabled="False" ToolTip="No Jobs to clear" AutomationProperties.Name="Clear all, no Jobs to clear" Click="JobsCancelAll_Click"/></Grid>
    <ListBox Grid.Row="2" x:Name="JobsDrawerList" Padding="0,0,16,0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="IsTabStop" Value="False"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource DrawerCard}" Margin="0,0,0,7"><Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="27"/><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource JobsRowHeaderButtonStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Tag="{Binding JobId}" AutomationProperties.Name="{Binding Name, StringFormat=Toggle details for {0}}" AutomationProperties.HelpText="Toggle expanded Job details" AutomationProperties.ItemStatus="{Binding IsExpanded, StringFormat=Expanded: {0}}" Click="JobExpansionToggle_Click"><Grid Width="12" Height="14"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="15" Text="›" Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVisibility}}"/><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ShellFocusBrush}" FontSize="13" Text="⌄" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"/></Grid></Button><local:JobsRadialProgress Grid.Column="1" Width="21" Height="21" VerticalAlignment="Center" Progress="{Binding Progress, Mode=OneWay}" State="{Binding State, Mode=OneWay}" AutomationProperties.Name="{Binding State, Mode=OneWay}"/><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="12" LineHeight="14" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" LineHeight="12" TextTrimming="CharacterEllipsis"><Run Text="{Binding State, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Eta, Mode=OneWay}"/></TextBlock></StackPanel></Grid>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="{Binding CanReorder, Converter={StaticResource BoolToVisibility}}"><Button Width="22" Height="22" Padding="0" Margin="0,0,2,0" FontSize="10" Content="↑" Tag="{Binding JobId}" IsEnabled="{Binding CanReorder}" ToolTip="Move waiting Job earlier" AutomationProperties.Name="Move waiting Job earlier" Click="JobsMoveUp_Click"/><Button Width="22" Height="22" Padding="0" Margin="0" FontSize="10" Content="↓" Tag="{Binding JobId}" IsEnabled="{Binding CanReorder}" ToolTip="Move waiting Job later" AutomationProperties.Name="Move waiting Job later" Click="JobsMoveDown_Click"/></StackPanel>
      </Grid>
      <Border Grid.Row="1" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" Margin="0,3,0,0" Padding="7" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" HorizontalAlignment="Stretch" ClipToBounds="True" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="1" CornerRadius="6"><StackPanel>
       <ProgressBar Height="4" HorizontalAlignment="Stretch" Maximum="100" Value="{Binding Progress, Mode=OneWay}"/>
       <Grid Margin="0,3,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding Elapsed, StringFormat=Elapsed {0}}"/><TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="{StaticResource TextBrush}" FontSize="10" TextAlignment="Right" Text="{Binding Progress, StringFormat={}{0:0}%}"/></Grid>
       <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="9" Text="OUTPUT"/><Border Margin="0,1,0,4" Padding="5,3" HorizontalAlignment="Stretch" ClipToBounds="True" Background="{StaticResource ShellSurfaceBrush}" CornerRadius="4"><TextBlock Foreground="{StaticResource TextBrush}" FontSize="10" LineHeight="12" Text="{Binding OutputPath}" TextWrapping="Wrap" TextTrimming="None" ToolTip="{Binding OutputPath}"/></Border>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="9" Text="VIDEO"/><TextBlock Grid.Column="1" Margin="4,0,6,0" Foreground="{StaticResource TextBrush}" FontSize="10" Text="{Binding ResolutionAndFrameRate}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Text="FORMAT"/><TextBlock Grid.Column="3" Margin="4,0,0,0" Foreground="{StaticResource TextBrush}" FontSize="10" Text="{Binding CodecAndContainer}"/><TextBlock Grid.Row="1" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Text="QUALITY"/><TextBlock Grid.Row="1" Grid.Column="1" Margin="4,0,6,0" Foreground="{StaticResource TextBrush}" FontSize="10" Text="{Binding Quality}" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Grid.Column="2" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Text="AUDIO"/><TextBlock Grid.Row="1" Grid.Column="3" Margin="4,0,0,0" Foreground="{StaticResource TextBrush}" FontSize="10" Text="{Binding Audio}" TextWrapping="Wrap"/><TextBlock Grid.Row="2" Foreground="{StaticResource MutedTextBrush}" FontSize="9" Text="COLOR"/><TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="4,0,0,0" Foreground="{StaticResource TextBrush}" FontSize="10" Text="{Binding Color}" TextWrapping="Wrap"/></Grid>
       <TextBlock Margin="0,3,0,0" Foreground="{StaticResource WarningBrush}" FontSize="10" Text="{Binding Issue}" TextWrapping="Wrap"/>
       <WrapPanel HorizontalAlignment="Right" Margin="0,4,0,0"><Button Padding="7,2" Content="Pause" Tag="{Binding JobId}" IsEnabled="{Binding CanPause}" Click="JobsPause_Click"/><Button Padding="7,2" Content="Resume" Tag="{Binding JobId}" IsEnabled="{Binding CanResume}" Click="JobsResume_Click"/><Button Padding="7,2" Content="Retry" Tag="{Binding JobId}" IsEnabled="{Binding CanRetry}" Click="JobsRetry_Click"/><Button Padding="7,2" Style="{StaticResource DangerButton}" Content="Cancel…" Tag="{Binding JobId}" IsEnabled="{Binding CanCancel}" AutomationProperties.Name="Cancel this Job" Click="JobsCancel_Click"/></WrapPanel>
      </StackPanel></Border>
     </Grid></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="3" Margin="0,8,16,0" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="Saved Jobs remain available in the full Jobs view"/>
   </Grid>
  </Border>
  </Grid>

  <!--
   One application-wide status strip rather than a Browser-specific bar stacked above an unrelated global
   one (#126): app health (Ellipse + StatusText) always occupies the left/fill side; the Browser-specific
   segment (count/selection/Preview activity, then a reserved slot for #125's thumbnail-size control) docks
   to the right and is shown only while the Browser tab is active — see MainWindow.SyncBrowserStatusBarVisibility.
  -->
  <Border Grid.Row="2" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="0,1,0,0" Padding="14,0">
   <DockPanel LastChildFill="True">
    <!-- #125: thumbnail-size control, the integration point #126 reserved here. No permanent text label —
         a small/large rendering of the same glyph flanks the slider (now clickable one-step decrease/
         increase buttons, not just decorative), and every control here carries its own accessible name/
         tooltip; understandable through iconography/tooltip/accessibility text alone. IsEnabled on the two
         buttons is kept current by MainWindow.ApplyBrowserThumbnailSize, the same single apply point the
         slider already used — no XAML default declared here, matching that method being the sole source of
         truth for every visual this control shows. -->
    <StackPanel x:Name="BrowserPresentationControls" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
     <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
      <ToggleButton x:Name="BrowserPreviewViewButton" Style="{StaticResource BrowserViewModeButtonStyle}" Tag="Preview" IsChecked="True"
       ToolTip="Preview view" AutomationProperties.Name="Preview view" Click="BrowserViewMode_Click">
       <Grid Width="16" Height="14"><Rectangle Margin="1" RadiusX="1" RadiusY="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5"/></Grid>
      </ToggleButton>
      <ToggleButton x:Name="BrowserInfoViewButton" Style="{StaticResource BrowserViewModeButtonStyle}" Tag="Info"
       ToolTip="Info view" AutomationProperties.Name="Info view" Click="BrowserViewMode_Click">
       <Grid Width="16" Height="14"><Rectangle Margin="1" RadiusX="1" RadiusY="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/><Rectangle Margin="3,4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Data="M3,2 L13,2 M3,12 L13,12"/></Grid>
      </ToggleButton>
      <ToggleButton x:Name="BrowserHybridViewButton" Style="{StaticResource BrowserViewModeButtonStyle}" Tag="Hybrid"
       ToolTip="Hybrid view" AutomationProperties.Name="Hybrid view" Click="BrowserViewMode_Click">
       <Grid Width="16" Height="14"><Rectangle Margin="1" RadiusX="1" RadiusY="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" Data="M3,4 L8,4 M3,7 L10,7"/></Grid>
      </ToggleButton>
     </StackPanel>
     <Border Width="1" Margin="0,3,8,3" Background="{StaticResource ShellDividerBrush}"/>
     <Button x:Name="BrowserRegenerateThumbnailsButton" Style="{StaticResource BrowserThumbnailSizeStepButtonStyle}" FontSize="13" Margin="0,0,7,0"
      Content="&#xE72C;" IsEnabled="False" ToolTip="Regenerate Previews" AutomationProperties.Name="Regenerate Previews"
      Click="BrowserRegenerateThumbnails_Click"/>
     <Button x:Name="BrowserThumbnailSizeDecreaseButton" Style="{StaticResource BrowserThumbnailSizeStepButtonStyle}" FontSize="9"
      Content="&#xE80A;" ToolTip="Decrease Preview size" AutomationProperties.Name="Decrease Preview size"
      Click="BrowserThumbnailSizeDecreaseButton_Click"/>
     <Slider x:Name="BrowserThumbnailSizeSlider" Style="{StaticResource BrowserThumbnailSizeSliderStyle}" Margin="6,0"
      Minimum="0" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1"
      ToolTip="Preview size" AutomationProperties.Name="Preview size"
      ValueChanged="BrowserThumbnailSizeSlider_ValueChanged"/>
     <Button x:Name="BrowserThumbnailSizeIncreaseButton" Style="{StaticResource BrowserThumbnailSizeStepButtonStyle}" FontSize="15"
      Content="&#xE80A;" ToolTip="Increase Preview size" AutomationProperties.Name="Increase Preview size"
      Click="BrowserThumbnailSizeIncreaseButton_Click"/>
    </StackPanel>
    <TextBlock x:Name="BrowserStatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
     FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="380" Margin="0,0,14,0" Visibility="Collapsed"/>
    <Border x:Name="BrowserStatusDivider" DockPanel.Dock="Right" Width="1" Margin="0,9,14,9" Background="{StaticResource ShellDividerBrush}" Visibility="Collapsed"/>
    <Button x:Name="JobsStatusButton" DockPanel.Dock="Right" Margin="0,0,12,0" Padding="9,3" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" Content="Jobs" ToolTip="Open Jobs activity" AutomationProperties.Name="Jobs, no active work" Click="JobsStatus_Click"/>
    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
     TextTrimming="CharacterEllipsis" Text="Checking FFmpeg…"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
