         <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="ENCODER"/><ComboBox x:Name="SettingsEncoderBackend" IsEnabled="False"><ComboBoxItem Content="NVIDIA NVENC"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="VIDEO CODEC"/><ComboBox x:Name="SettingsVideoCodec"><ComboBoxItem Content="H.264"/><ComboBoxItem Content="HEVC (H.265)"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="CONTAINER"/><ComboBox x:Name="SettingsContainer"><ComboBoxItem Content="MP4"/><ComboBoxItem Content="MKV"/><ComboBoxItem Content="MOV"/></ComboBox></StackPanel><StackPanel Grid.Column="3"><TextBlock Style="{StaticResource FieldLabel}" Text="AUDIO"/><ComboBox x:Name="SettingsAudioMode"><ComboBoxItem Content="Copy source"/><ComboBoxItem Content="AAC"/><ComboBoxItem Content="No audio"/></ComboBox></StackPanel></Grid>
         <Expander x:Name="SettingsAdvancedExportOptions" Margin="0,14,0,0" Header="Advanced encoder options" Foreground="{StaticResource TextBrush}" AutomationProperties.Name="Advanced encoder options"><StackPanel Margin="0,10,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="NVENC PRESET (P1–P7)"/><TextBox x:Name="SettingsEncoderPreset"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="TUNING"/><ComboBox x:Name="SettingsTune"><ComboBoxItem Content="High quality"/><ComboBoxItem Content="Low latency"/><ComboBoxItem Content="Ultra-low latency"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="RATE CONTROL"/><ComboBox x:Name="SettingsRateControl"><ComboBoxItem Content="Constant quality"/><ComboBoxItem Content="Variable bitrate"/><ComboBoxItem Content="Constant bitrate"/></ComboBox></StackPanel><StackPanel Grid.Column="3"><TextBlock Style="{StaticResource FieldLabel}" Text="MULTIPASS"/><ComboBox x:Name="SettingsMultipass"><ComboBoxItem Content="Disabled"/><ComboBoxItem Content="Quarter resolution"/><ComboBoxItem Content="Full resolution"/></ComboBox></StackPanel></Grid>
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="QUALITY (0–51)"/><TextBox x:Name="SettingsQuality"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="TARGET BITRATE (MBPS)"/><TextBox x:Name="SettingsTargetBitrate"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="MAX BITRATE (MBPS)"/><TextBox x:Name="SettingsMaxBitrate"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Style="{StaticResource FieldLabel}" Text="AQ STRENGTH (1–15)"/><TextBox x:Name="SettingsAqStrength"/></StackPanel></Grid>
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="PIXEL FORMAT"/><ComboBox x:Name="SettingsPixelFormat"><ComboBoxItem Content="8-bit YUV 4:2:0"/><ComboBoxItem Content="10-bit P010 (HEVC)"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="FRAME RATE"/><ComboBox x:Name="SettingsFrameRate"><ComboBoxItem Content="Source"/><ComboBoxItem Content="23.976"/><ComboBoxItem Content="24"/><ComboBoxItem Content="25"/><ComboBoxItem Content="29.97"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="59.94"/><ComboBoxItem Content="60"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="AAC BITRATE (KBPS)"/><TextBox x:Name="SettingsAudioBitrate"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Style="{StaticResource FieldLabel}" Text="AUDIO SAMPLE RATE"/><ComboBox x:Name="SettingsAudioSampleRate"><ComboBoxItem Content="Source"/><ComboBoxItem Content="44.1 kHz"/><ComboBoxItem Content="48 kHz"/><ComboBoxItem Content="96 kHz"/></ComboBox></StackPanel></Grid>
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="AUDIO CHANNELS"/><ComboBox x:Name="SettingsAudioChannels"><ComboBoxItem Content="Source"/><ComboBoxItem Content="Mono"/><ComboBoxItem Content="Stereo"/></ComboBox></StackPanel><WrapPanel Grid.Column="1" Margin="8,22,0,0"><CheckBox x:Name="SettingsDeinterlace" Content="Deinterlace"/><CheckBox x:Name="SettingsSpatialAq" Content="Spatial AQ"/><CheckBox x:Name="SettingsTemporalAq" Content="Temporal AQ"/><CheckBox x:Name="SettingsFastStart" Content="Fast start for MP4/MOV"/></WrapPanel></Grid>
