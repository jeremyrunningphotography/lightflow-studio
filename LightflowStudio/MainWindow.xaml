          <ProgressBar x:Name="PreviewMaintenanceProgress" Margin="0,8,0,0" Height="8" Minimum="0" Maximum="1" Visibility="Collapsed"/><TextBlock x:Name="PreviewMaintenanceStatus" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
         </StackPanel></Border>
         <Expander Margin="0,12,0,0" Header="Catalog backup and recovery" Foreground="{StaticResource TextBrush}" AutomationProperties.Name="Catalog backup and recovery"><Border Style="{StaticResource SettingsInsetPanelStyle}"><StackPanel><TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Validated Catalog backups are separate from rebuildable Previews. Restore protects the current Catalog before making changes."/><ComboBox x:Name="CatalogBackupSelection" DisplayMemberPath="DisplayName" AutomationProperties.Name="Catalog backup selection"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Back Up Now" Click="BackupCatalog_Click"/><Button Style="{StaticResource DangerButton}" Content="Restore Selected…" Click="RestoreCatalog_Click"/></StackPanel></StackPanel></Border></Expander>
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsSectionStyle}"><StackPanel><DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Add Media Root…" Click="AddMediaRoot_Click"/><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Media Roots"/><TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="0,4,16,0" Text="Stable Catalog locations for originals. Each computer connects the same logical root to its own folder path."/></StackPanel></DockPanel><TextBlock x:Name="MediaRootsEmptyText" Margin="4,8" Foreground="{StaticResource MutedTextBrush}" Text="No Media Roots yet."/><ItemsControl x:Name="MediaRootsList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SettingsInsetPanelStyle}" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><DockPanel><TextBlock Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Text="{Binding DisplayName}"/><Border Margin="10,0,0,0" Padding="7,2" CornerRadius="8" Background="#34261A"><TextBlock FontSize="10" Foreground="{StaticResource OrangeBrush}" Text="{Binding Availability}"/></Border></DockPanel><TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PhysicalPath}" Text="{Binding PhysicalPath}"/><TextBlock Margin="0,3,0,0" Foreground="#D7A25C" TextWrapping="Wrap" Text="{Binding Diagnostic}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Rename" Click="RenameMediaRoot_Click"/><Button Content="Reconnect…" Click="ReconnectMediaRoot_Click"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
       </StackPanel></ScrollViewer>

       <ScrollViewer x:Name="SettingsToolsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Tools settings page"><StackPanel MaxWidth="900" HorizontalAlignment="Left">
