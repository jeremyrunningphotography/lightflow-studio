<Window x:Class="LightflowStudio.NewCollectionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="12">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Style="{StaticResource PageTitle}" FontSize="20" Text="New Collection"/>
   <TextBox Grid.Row="1" x:Name="NameText" Margin="0,10,0,0" MaxLength="255" AutomationProperties.Name="Collection name"/>
   <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <CheckBox x:Name="WithinSetCheck" Content="Create within" VerticalAlignment="Center" Checked="PlacementChanged" Unchecked="PlacementChanged"/>
    <ComboBox Grid.Column="1" x:Name="SetCombo" Margin="10,0,0,0" DisplayMemberPath="DisplayName" AutomationProperties.Name="Collection Set placement"/>
   </Grid>
   <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button IsCancel="True" Content="Cancel" Click="Cancel_Click"/>
    <Button IsDefault="True" Content="Create" Click="Create_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
