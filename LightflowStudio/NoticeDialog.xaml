<Window x:Class="LightflowStudio.NoticeDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="12">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="HeadingText" Style="{StaticResource PageTitle}" FontSize="20" TextWrapping="Wrap"/>
   <TextBlock Grid.Row="1" x:Name="MessageText" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
   <Button Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" IsDefault="True" Content="OK" Click="Ok_Click"/>
  </Grid>
 </Border>
</Window>
