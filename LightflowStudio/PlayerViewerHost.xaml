<UserControl x:Class="LightflowStudio.PlayerViewerHost"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:LightflowStudio"
 Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="PlayerViewerHost_PreviewKeyDown">
 <UserControl.Resources>
  <!-- Copied from TrimEditorWindow.xaml rather than extracted into the shared shell dictionary — the same
       small-scale local-duplication precedent #125 already established for an analogous slider hit-area
       (see MainWindow.xaml's BrowserThumbnailSizeSliderHitArea). Keeping this control's resources local also
       keeps it genuinely host-independent: nothing here depends on being hosted inside MainWindow.xaml's own
       resource dictionary, only on the app-wide brushes App.xaml already merges from Themes/LightflowShell.xaml. -->
  <Style x:Key="PlaybackTimelineHitArea" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlaybackTimelineSlider" TargetType="Slider">
   <Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid VerticalAlignment="Center" Height="22">
     <Border Height="6" VerticalAlignment="Center" Background="#0A0C10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"/>
     <Track x:Name="PART_Track" VerticalAlignment="Center" Height="18">
      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PlaybackTimelineHitArea}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="14" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Playhead" Width="5" Height="18" Background="{StaticResource OrangeBrush}" BorderBrush="#FFFFE6" BorderThickness="1" CornerRadius="3"><Border.Effect><DropShadowEffect Color="#FF713D" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/></Border.Effect></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Playhead" Property="Background" Value="{StaticResource RedBrush}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Playhead" Property="Background" Value="{StaticResource MagentaBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PlaybackTimelineHitArea}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RangeSetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="Background" Value="#15181E"/><Setter Property="BorderBrush" Value="#292E37"/>
   <Style.Triggers>
    <Trigger Property="Tag" Value="Active"><Setter Property="Background" Value="#2B181D"/><Setter Property="BorderBrush" Value="{StaticResource OrangeBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="RangeTimestampLink" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="Padding" Value="2,1"/><Setter Property="Margin" Value="2,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Underline" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter TargetName="Underline" Property="BorderBrush" Value="#6A7381"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter TargetName="Underline" Property="BorderBrush" Value="{StaticResource OrangeBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RangeClearButton" TargetType="Button">
   <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,2,0"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#20242C"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource OrangeBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border Style="{StaticResource ShellPanel}" Background="#07090D" Padding="0" ClipToBounds="True">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <DockPanel Grid.Row="0" Margin="12,10,12,8">
    <Button x:Name="BackButton" DockPanel.Dock="Left" Padding="10,6" Click="BackButton_Click"
     ToolTip="Back to Browser (Esc)" AutomationProperties.Name="Back to Browser">
     <!-- A horizontal StackPanel top-aligns its children by default rather than stretching them, and the
          Segoe Fluent Icons/Segoe MDL2 Assets glyph's own line-height/baseline differs from the plain-text
          run's — without an explicit VerticalAlignment on each child, that natural-height difference reads as
          the arrow sitting visibly higher than "Back". Centering both independently (not just the StackPanel
          itself, which only affects its position within the Button's own content area) aligns their vertical
          centers as one control regardless of that font-metric mismatch. -->
     <StackPanel Orientation="Horizontal">
      <TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72B;" Margin="0,0,6,0"/>
      <TextBlock VerticalAlignment="Center" Text="Back"/>
     </StackPanel>
    </Button>
    <TextBlock x:Name="AssetNameText" DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center"
     Foreground="{StaticResource TextBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
   </DockPanel>

   <!-- The one authoritative background for the media surface, matching BrowserGridHost's own single-source-of-
        background convention so no seam can appear between this and the surrounding chrome. -->
   <Grid Grid.Row="1" x:Name="MediaSurfaceHost" Background="Black">
    <Grid x:Name="VideoHost"/>
    <Image x:Name="SteppedFrameSurface" Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed"/>
    <Image x:Name="ImageSurface" Stretch="Uniform" Visibility="Collapsed"/>
    <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
     TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
   </Grid>

   <Border Grid.Row="2" x:Name="TransportBar" Margin="12,0,12,12" Padding="14,10,14,9" Visibility="Collapsed"
    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Height="22">
      <local:TrimRangeIndicator x:Name="ReviewRangeIndicator" Height="18" Margin="7,0" VerticalAlignment="Center"
       Panel.ZIndex="1" IsHitTestVisible="False"/>
      <Slider x:Name="PositionSlider" Style="{StaticResource PlaybackTimelineSlider}" Minimum="0" Maximum="1"
       ValueChanged="PositionSlider_ValueChanged" PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
       IsEnabled="False" ToolTip="Full source timeline: click anywhere to seek, or drag the playhead"/>
     </Grid>
     <Grid Grid.Row="1" Margin="2,4,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
       <Button x:Name="SetInButton" Style="{StaticResource RangeSetButton}" Content="Set In" Click="SetIn_Click" IsEnabled="False" ToolTip="Set In to the displayed frame (I)" AutomationProperties.Name="Set In"/>
       <Button x:Name="InTimeButton" Style="{StaticResource RangeTimestampLink}" Click="InTime_Click" Visibility="Collapsed" ToolTip="Seek to saved In frame" AutomationProperties.Name="Seek to saved In frame"/>
       <Button x:Name="ClearInButton" Style="{StaticResource RangeClearButton}" Content="&#x00D7;" Click="ClearIn_Click" Visibility="Collapsed" ToolTip="Clear In boundary" AutomationProperties.Name="Clear In boundary"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
       <Button x:Name="OutTimeButton" Style="{StaticResource RangeTimestampLink}" Click="OutTime_Click" Visibility="Collapsed" ToolTip="Seek to saved Out frame" AutomationProperties.Name="Seek to saved Out frame"/>
       <Button x:Name="ClearOutButton" Style="{StaticResource RangeClearButton}" Content="&#x00D7;" Click="ClearOut_Click" Visibility="Collapsed" ToolTip="Clear Out boundary" AutomationProperties.Name="Clear Out boundary"/>
       <Button x:Name="SetOutButton" Style="{StaticResource RangeSetButton}" Content="Set Out" Click="SetOut_Click" IsEnabled="False" ToolTip="Set Out to the displayed frame (O)" AutomationProperties.Name="Set Out"/>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="2" Margin="2,7,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CurrentTimeText" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Text="00:00:00.000"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
       <Button x:Name="PreviousFrameButton" Content="&#x25C4; Frame" Click="PreviousFrame_Click" IsEnabled="False"
        ToolTip="Previous decoded frame (,)" AutomationProperties.Name="Previous frame"/>
       <Button x:Name="PlayPauseButton" MinWidth="88" Content="Play" Click="PlayPause_Click" IsEnabled="False"
        ToolTip="Play/Pause (Space)" AutomationProperties.Name="Play or pause"/>
       <Button x:Name="NextFrameButton" Content="Frame &#x25BA;" Click="NextFrame_Click" IsEnabled="False"
        ToolTip="Next decoded frame (.)" AutomationProperties.Name="Next frame"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
       <TextBlock x:Name="ScreengrabFeedbackText" MaxWidth="220" Margin="0,0,6,0" VerticalAlignment="Center"
        Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
        AutomationProperties.LiveSetting="Polite"/>
       <Button x:Name="ScreengrabSuccessButton" Width="26" Height="26" Padding="0" Margin="0,0,4,0"
        Visibility="Collapsed" Click="ScreengrabSuccess_Click" Foreground="{StaticResource SuccessBrush}"
        ToolTip="Screengrab saved. Open folder" AutomationProperties.Name="Screengrab saved. Open screengrab folder"
        AutomationProperties.LiveSetting="Polite">
        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE73E;"/>
       </Button>
       <Button x:Name="ScreengrabButton" Width="34" Height="30" Padding="0" BorderThickness="1"
        FocusVisualStyle="{x:Null}" Click="Screengrab_Click" IsEnabled="False"
        ToolTip="Save full-resolution frame as PNG" AutomationProperties.Name="Save full-resolution screengrab">
        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE722;"/>
       </Button>
       <TextBlock x:Name="DurationText" VerticalAlignment="Center" Margin="10,0,12,0"
        Foreground="{StaticResource MutedTextBrush}" Text="00:00:00.000"/>
       <Button x:Name="MuteButton" Width="34" Height="30" Padding="0" BorderThickness="1"
        FocusVisualStyle="{x:Null}" Click="MuteButton_Click" IsEnabled="False"
        ToolTip="Mute" AutomationProperties.Name="Mute or unmute">
        <TextBlock x:Name="MuteIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE767;"/>
       </Button>
       <Slider x:Name="VolumeSlider" Style="{StaticResource PlaybackTimelineSlider}" Width="70" Margin="6,0,0,0"
        Minimum="0" Maximum="100" ValueChanged="VolumeSlider_ValueChanged" PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown"
        IsEnabled="False" ToolTip="Click anywhere to set the volume, or drag the thumb" AutomationProperties.Name="Volume"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Border>
  </Grid>
 </Border>
</UserControl>
