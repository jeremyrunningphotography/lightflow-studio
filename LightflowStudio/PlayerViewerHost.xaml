<UserControl x:Class="LightflowStudio.PlayerViewerHost"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:LightflowStudio"
 Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="PlayerViewerHost_PreviewKeyDown" PreviewKeyUp="PlayerViewerHost_PreviewKeyUp" LostKeyboardFocus="PlayerViewerHost_LostKeyboardFocus">
 <UserControl.Resources>
  <!-- Copied from TrimEditorWindow.xaml rather than extracted into the shared shell dictionary — the same
       small-scale local-duplication precedent #125 already established for an analogous slider hit-area
       (see MainWindow.xaml's BrowserThumbnailSizeSliderHitArea). Keeping this control's resources local also
       keeps it genuinely host-independent: nothing here depends on being hosted inside MainWindow.xaml's own
       resource dictionary, only on the app-wide brushes App.xaml already merges from Themes/LightflowShell.xaml. -->
  <Style x:Key="PlaybackTimelineHitArea" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlaybackTimelineSlider" TargetType="Slider">
   <Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid VerticalAlignment="Center" Height="22">
     <Border Height="6" VerticalAlignment="Center" Background="#0A0C10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"/>
     <Track x:Name="PART_Track" VerticalAlignment="Center" Height="18">
      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PlaybackTimelineHitArea}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="14" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Playhead" Width="5" Height="18" Background="{StaticResource OrangeBrush}" BorderBrush="#FFFFE6" BorderThickness="1" CornerRadius="3"><Border.Effect><DropShadowEffect Color="#FF713D" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/></Border.Effect></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Playhead" Property="Background" Value="{StaticResource RedBrush}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Playhead" Property="Background" Value="{StaticResource MagentaBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PlaybackTimelineHitArea}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RangeSetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="Background" Value="#15181E"/><Setter Property="BorderBrush" Value="#292E37"/>
   <Style.Triggers>
    <Trigger Property="Tag" Value="Active"><Setter Property="Background" Value="#2B181D"/><Setter Property="BorderBrush" Value="{StaticResource OrangeBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="RangeTimestampLink" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="Padding" Value="2,1"/><Setter Property="Margin" Value="2,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Underline" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter TargetName="Underline" Property="BorderBrush" Value="#6A7381"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter TargetName="Underline" Property="BorderBrush" Value="{StaticResource OrangeBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RangeClearButton" TargetType="Button">
   <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,2,0"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#20242C"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource OrangeBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlayerClassificationChoice" TargetType="ToggleButton">
   <Setter Property="Height" Value="24"/><Setter Property="MinWidth" Value="24"/><Setter Property="Padding" Value="4,2"/><Setter Property="Margin" Value="1,0"/>
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Grid x:Name="InteractionSurface" Background="Transparent" RenderTransformOrigin="0.5,0.5">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.58"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/><Condition Binding="{Binding (KeyboardNavigation.ShowKeyboardCues), RelativeSource={RelativeSource TemplatedParent}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="InteractionSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.12" ScaleY="1.12"/></Setter.Value></Setter></MultiDataTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlayerStarChoice" TargetType="ToggleButton" BasedOn="{StaticResource PlayerClassificationChoice}">
   <Setter Property="Width" Value="25"/><Setter Property="ToolTip" Value="Set rating"/>
   <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource ClassificationRatingBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="PlayerSwatchChoice" TargetType="ToggleButton" BasedOn="{StaticResource PlayerClassificationChoice}">
   <Setter Property="Width" Value="24"/><Setter Property="Padding" Value="4"/>
   <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="PlayerRatingStarPath" TargetType="Path">
   <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/><Setter Property="StrokeThickness" Value="1.4"/><Setter Property="Fill" Value="Transparent"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="PlayerPickFlagPath" TargetType="Path">
   <Setter Property="Fill" Value="{StaticResource ClassificationPickedInactiveBrush}"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="Fill" Value="{StaticResource ClassificationPickedActiveBrush}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="PlayerRejectFlagPath" TargetType="Path">
   <Setter Property="Fill" Value="{StaticResource ClassificationRejectedInteriorBrush}"/><Setter Property="Stroke" Value="{StaticResource ClassificationRejectedInactiveBrush}"/><Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="Stroke" Value="{StaticResource ClassificationRejectedActiveBrush}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="PlayerRejectXPath" TargetType="Path">
   <Setter Property="Stroke" Value="{StaticResource ClassificationRejectedInactiveBrush}"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="Stroke" Value="{StaticResource ClassificationRejectedActiveBrush}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="PlayerColorSwatch" TargetType="Ellipse">
   <Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/><Setter Property="Stroke" Value="Transparent"/><Setter Property="StrokeThickness" Value="0"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stroke" Value="{StaticResource TextBrush}"/><Setter Property="StrokeThickness" Value="2"/></DataTrigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Border x:Name="PlayerBorder" Style="{StaticResource ShellPanel}" Background="#07090D" Padding="0" ClipToBounds="True">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <DockPanel x:Name="PlayerHeader" Grid.Row="0" Grid.Column="0" Margin="6,5,6,4">
    <Button x:Name="BackButton" DockPanel.Dock="Left" Padding="10,6" Click="BackButton_Click"
     ToolTip="Back to Browser (Esc)" AutomationProperties.Name="Back to Browser">
     <!-- A horizontal StackPanel top-aligns its children by default rather than stretching them, and the
          Segoe Fluent Icons/Segoe MDL2 Assets glyph's own line-height/baseline differs from the plain-text
          run's — without an explicit VerticalAlignment on each child, that natural-height difference reads as
          the arrow sitting visibly higher than "Back". Centering both independently (not just the StackPanel
          itself, which only affects its position within the Button's own content area) aligns their vertical
          centers as one control regardless of that font-metric mismatch. -->
     <StackPanel Orientation="Horizontal">
      <TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72B;" Margin="0,0,6,0"/>
      <TextBlock VerticalAlignment="Center" Text="Back"/>
     </StackPanel>
    </Button>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <ComboBox x:Name="ZoomChoice" Width="82" Margin="4,0" SelectionChanged="ZoomChoice_Changed" ToolTip="Display zoom (Ctrl+wheel); drag to pan" AutomationProperties.Name="Display zoom">
      <ComboBoxItem Content="Fit"/><ComboBoxItem Content="50%"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="400%"/>
     </ComboBox>
     <Button x:Name="FullscreenButton" AutomationProperties.Name="Full Screen" Click="Fullscreen_Click" ToolTip="Full Screen (double-click media); Esc to return"/>
    </StackPanel>
    <TextBlock x:Name="AssetNameText" DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center"
     Foreground="{StaticResource TextBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
   </DockPanel>

   <!-- The one authoritative background for the media surface, matching BrowserGridHost's own single-source-of-
        background convention so no seam can appear between this and the surrounding chrome. -->
   <Grid Grid.Row="1" Grid.Column="0" x:Name="MediaSurfaceHost" Background="Black" ClipToBounds="True" SizeChanged="MediaViewport_SizeChanged">
    <Grid x:Name="VideoHost"/>
    <Image x:Name="SteppedFrameSurface" Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed"/>
    <Image x:Name="ImageSurface" Stretch="Uniform" Visibility="Collapsed"/>
    <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
     TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
   </Grid>

   <Border Grid.Row="2" Grid.Column="0" x:Name="TransportBar" Margin="6,0,6,6" Padding="7,5,7,5" Visibility="Collapsed"
    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid x:Name="ColorSurface" Margin="1,0,1,4" HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="PlayerColorGroup" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
       <TextBlock Text="COLOR" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource ShellNavigationTextBrush}" FontSize="10" FontWeight="SemiBold"/>
       <TextBlock Text="Camera" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
       <ComboBox x:Name="CameraLutCombo" Width="150" Height="26" SelectionChanged="CameraLutCombo_SelectionChanged" IsEnabled="False" ToolTip="Camera / technical LUT; hold C for momentary Original" AutomationProperties.Name="Camera LUT"/>
       <TextBlock Text="Creative" Margin="12,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
       <ComboBox x:Name="CreativeLutCombo" Width="150" Height="26" SelectionChanged="CreativeLutCombo_SelectionChanged" IsEnabled="False" ToolTip="Creative LUT; hold C for momentary Original" AutomationProperties.Name="Creative LUT"/>
      </StackPanel>
      <Button x:Name="ExportButton" Grid.Column="2" HorizontalAlignment="Right" Margin="6,0,0,0" Padding="5,2" Style="{StaticResource ExportLaunchButton}" Content="Export…" IsEnabled="False"
       Click="ExportButton_Click" ToolTip="Export this asset with its saved range and assigned Color" AutomationProperties.Name="Export current asset"/>
     </Grid>
     <Grid Grid.Row="1" Margin="2,0,2,4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="PlayerRatingGroup" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
       <ToggleButton x:Name="PlayerRating1" Style="{StaticResource PlayerStarChoice}" Tag="1" Click="PlayerRating_Click" AutomationProperties.Name="1 star"><Path Style="{StaticResource PlayerRatingStarPath}" Data="{StaticResource ClassificationStarGeometry}"/></ToggleButton>
       <ToggleButton x:Name="PlayerRating2" Style="{StaticResource PlayerStarChoice}" Tag="2" Click="PlayerRating_Click" AutomationProperties.Name="2 stars"><Path Style="{StaticResource PlayerRatingStarPath}" Data="{StaticResource ClassificationStarGeometry}"/></ToggleButton>
       <ToggleButton x:Name="PlayerRating3" Style="{StaticResource PlayerStarChoice}" Tag="3" Click="PlayerRating_Click" AutomationProperties.Name="3 stars"><Path Style="{StaticResource PlayerRatingStarPath}" Data="{StaticResource ClassificationStarGeometry}"/></ToggleButton>
       <ToggleButton x:Name="PlayerRating4" Style="{StaticResource PlayerStarChoice}" Tag="4" Click="PlayerRating_Click" AutomationProperties.Name="4 stars"><Path Style="{StaticResource PlayerRatingStarPath}" Data="{StaticResource ClassificationStarGeometry}"/></ToggleButton>
       <ToggleButton x:Name="PlayerRating5" Style="{StaticResource PlayerStarChoice}" Tag="5" Click="PlayerRating_Click" AutomationProperties.Name="5 stars"><Path Style="{StaticResource PlayerRatingStarPath}" Data="{StaticResource ClassificationStarGeometry}"/></ToggleButton>
      </StackPanel>
      <StackPanel x:Name="PlayerFlagGroup" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
       <ToggleButton x:Name="PlayerReject" Style="{StaticResource PlayerClassificationChoice}" Tag="Rejected" Click="PlayerFlag_Click" ToolTip="Reject" AutomationProperties.Name="Reject"><Viewbox Width="15" Height="15" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Style="{StaticResource PlayerRejectFlagPath}" Data="{StaticResource ClassificationRejectedFlagGeometry}"/><Path Style="{StaticResource PlayerRejectXPath}" StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource ClassificationRejectedXGeometry}"/></Canvas></Viewbox></ToggleButton>
       <ToggleButton x:Name="PlayerPick" Style="{StaticResource PlayerClassificationChoice}" Tag="Picked" Click="PlayerFlag_Click" ToolTip="Pick" AutomationProperties.Name="Pick"><Viewbox Width="15" Height="15" Stretch="Uniform"><Canvas Width="24" Height="24"><Path StrokeLineJoin="Round" Style="{StaticResource PlayerPickFlagPath}" Data="{StaticResource ClassificationPickedFlagGeometry}"/></Canvas></Viewbox></ToggleButton>
      </StackPanel>
      <StackPanel x:Name="PlayerLabelGroup" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
       <ToggleButton x:Name="PlayerNoLabel" Style="{StaticResource PlayerSwatchChoice}" Tag="None" Click="PlayerColorLabel_Click" ToolTip="No color label" AutomationProperties.Name="No color label"><Grid Width="15" Height="15"><Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeStartLineCap="Round" Data="M3,12 L12,3"/></Grid></ToggleButton>
       <ToggleButton x:Name="PlayerLabelRed" Style="{StaticResource PlayerSwatchChoice}" Tag="Red" Click="PlayerColorLabel_Click" ToolTip="Red label" AutomationProperties.Name="Red label"><Ellipse Style="{StaticResource PlayerColorSwatch}" Fill="{StaticResource ClassificationLabelRedBrush}"/></ToggleButton>
       <ToggleButton x:Name="PlayerLabelYellow" Style="{StaticResource PlayerSwatchChoice}" Tag="Yellow" Click="PlayerColorLabel_Click" ToolTip="Yellow label" AutomationProperties.Name="Yellow label"><Ellipse Style="{StaticResource PlayerColorSwatch}" Fill="{StaticResource ClassificationLabelYellowBrush}"/></ToggleButton>
       <ToggleButton x:Name="PlayerLabelGreen" Style="{StaticResource PlayerSwatchChoice}" Tag="Green" Click="PlayerColorLabel_Click" ToolTip="Green label" AutomationProperties.Name="Green label"><Ellipse Style="{StaticResource PlayerColorSwatch}" Fill="{StaticResource ClassificationLabelGreenBrush}"/></ToggleButton>
       <ToggleButton x:Name="PlayerLabelBlue" Style="{StaticResource PlayerSwatchChoice}" Tag="Blue" Click="PlayerColorLabel_Click" ToolTip="Blue label" AutomationProperties.Name="Blue label"><Ellipse Style="{StaticResource PlayerColorSwatch}" Fill="{StaticResource ClassificationLabelAzureBrush}"/></ToggleButton>
       <ToggleButton x:Name="PlayerLabelPurple" Style="{StaticResource PlayerSwatchChoice}" Tag="Purple" Click="PlayerColorLabel_Click" ToolTip="Purple label" AutomationProperties.Name="Purple label"><Ellipse Style="{StaticResource PlayerColorSwatch}" Fill="{StaticResource ClassificationLabelPurpleBrush}"/></ToggleButton>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="2" Height="22">
      <local:TrimRangeIndicator x:Name="ReviewRangeIndicator" Height="18" Margin="7,0" VerticalAlignment="Center"
       Panel.ZIndex="1" IsHitTestVisible="False"/>
      <Slider x:Name="PositionSlider" Style="{StaticResource PlaybackTimelineSlider}" Minimum="0" Maximum="1"
       ValueChanged="PositionSlider_ValueChanged" PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
       IsEnabled="False" ToolTip="Full source timeline: click anywhere to seek, or drag the playhead"/>
     </Grid>
     <Grid x:Name="RangeReviewRow" Grid.Row="3" Margin="2,4,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="ReviewControlGroup" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
       <ToggleButton x:Name="LoopChoice" Style="{StaticResource PlayerClassificationChoice}" ToolTip="Loop playback" AutomationProperties.Name="Loop playback" Margin="0,0,6,0">
        <Path Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.6" Data="M3,9 A8,8 0 0 1 18,5 L18,1 M18,5 L14,5 M21,15 A8,8 0 0 1 6,19 L6,23 M6,19 L10,19">
         <Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="{StaticResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=LoopChoice}" Value="True"><Setter Property="Stroke" Value="{StaticResource OrangeBrush}"/></DataTrigger></Style.Triggers></Style></Path.Style>
        </Path>
       </ToggleButton>
       <ComboBox x:Name="SpeedChoice" Width="72" Height="26" SelectionChanged="ReviewOptions_Changed" AutomationProperties.Name="Playback speed" ToolTip="Playback speed; audio follows the selected speed"/>
       <TextBlock Text="fps" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,5,0"/>
       <ComboBox x:Name="CadenceChoiceBox" Width="132" Height="26" SelectionChanged="ReviewOptions_Changed" AutomationProperties.Name="Frame Rate Preview" ToolTip="Preview lower frame-rate cadence independently of playback speed"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
       <Button x:Name="SetInButton" Style="{StaticResource RangeSetButton}" Content="Set In" Click="SetIn_Click" IsEnabled="False" ToolTip="Set In to the displayed frame (I)" AutomationProperties.Name="Set In"/>
       <Button x:Name="InTimeButton" Style="{StaticResource RangeTimestampLink}" Click="InTime_Click" Visibility="Collapsed" ToolTip="Seek to saved In frame" AutomationProperties.Name="Seek to saved In frame"/>
       <Button x:Name="ClearInButton" Style="{StaticResource RangeClearButton}" Content="&#x00D7;" Click="ClearIn_Click" Visibility="Collapsed" ToolTip="Clear In boundary" AutomationProperties.Name="Clear In boundary"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
       <Button x:Name="OutTimeButton" Style="{StaticResource RangeTimestampLink}" Click="OutTime_Click" Visibility="Collapsed" ToolTip="Seek to saved Out frame" AutomationProperties.Name="Seek to saved Out frame"/>
       <Button x:Name="ClearOutButton" Style="{StaticResource RangeClearButton}" Content="&#x00D7;" Click="ClearOut_Click" Visibility="Collapsed" ToolTip="Clear Out boundary" AutomationProperties.Name="Clear Out boundary"/>
       <Button x:Name="SetOutButton" Style="{StaticResource RangeSetButton}" Content="Set Out" Click="SetOut_Click" IsEnabled="False" ToolTip="Set Out to the displayed frame (O)" AutomationProperties.Name="Set Out"/>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="4" Margin="2,7,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CurrentTimeText" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Text="00:00:00.000"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
       <Button x:Name="PreviousFrameButton" Content="&#x25C4; Frame" Click="PreviousFrame_Click" IsEnabled="False"
        ToolTip="Previous decoded frame (,)" AutomationProperties.Name="Previous frame"/>
       <Button x:Name="PlayPauseButton" MinWidth="88" Content="Play" Click="PlayPause_Click" IsEnabled="False"
        ToolTip="Play/Pause (Space)" AutomationProperties.Name="Play or pause"/>
       <Button x:Name="NextFrameButton" Content="Frame &#x25BA;" Click="NextFrame_Click" IsEnabled="False"
        ToolTip="Next decoded frame (.)" AutomationProperties.Name="Next frame"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
       <TextBlock x:Name="ScreengrabFeedbackText" MaxWidth="220" Margin="0,0,6,0" VerticalAlignment="Center"
        Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
        AutomationProperties.LiveSetting="Polite"/>
       <Button x:Name="ScreengrabSuccessButton" Width="26" Height="26" Padding="0" Margin="0,0,4,0"
        Visibility="Collapsed" Click="ScreengrabSuccess_Click" Foreground="{StaticResource OrangeBrush}"
        ToolTip="Screengrab saved. Open folder" AutomationProperties.Name="Screengrab saved. Open screengrab folder"
        AutomationProperties.LiveSetting="Polite">
        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE73E;"/>
       </Button>
       <Button x:Name="ScreengrabButton" Width="34" Height="30" Padding="0" BorderThickness="1"
        FocusVisualStyle="{x:Null}" Click="Screengrab_Click" IsEnabled="False"
        ToolTip="Save the current paused frame as a full-resolution PNG" AutomationProperties.Name="Save paused frame as full-resolution screengrab">
        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE722;"/>
       </Button>
       <Button x:Name="SetPreviewFrameButton" Width="34" Height="30" Padding="0" Margin="4,0,0,0" BorderThickness="1"
        FocusVisualStyle="{x:Null}" Click="SetPreviewFrame_Click" IsEnabled="False"
        ToolTip="Use the current paused frame as this asset's Browser Preview" AutomationProperties.Name="Set paused frame as Browser Preview">
        <Button.ContextMenu>
         <ContextMenu Style="{StaticResource LightflowContextMenuStyle}">
          <MenuItem Style="{StaticResource LightflowMenuItemStyle}" Header="Reset to Automatic Preview"
           Click="ResetPreviewFrame_Click" AutomationProperties.Name="Reset to Automatic Preview"/>
         </ContextMenu>
        </Button.ContextMenu>
        <Grid Width="17" Height="17">
         <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
          StrokeLineJoin="Round" Data="M1,3 L16,3 L16,14 L1,14 Z M4,11 L7,8 L9,10 L12,7 L16,11"/>
         <Ellipse Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
          Fill="{StaticResource OrangeBrush}"/>
        </Grid>
       </Button>
       <TextBlock x:Name="DurationText" VerticalAlignment="Center" Margin="10,0,12,0"
        Foreground="{StaticResource MutedTextBrush}" Text="00:00:00.000"/>
       <Button x:Name="MuteButton" Width="34" Height="30" Padding="0" BorderThickness="1"
        FocusVisualStyle="{x:Null}" Click="MuteButton_Click" IsEnabled="False"
        ToolTip="Mute" AutomationProperties.Name="Mute or unmute">
        <TextBlock x:Name="MuteIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE767;"/>
       </Button>
       <Slider x:Name="VolumeSlider" Style="{StaticResource PlaybackTimelineSlider}" Width="70" Margin="6,0,0,0"
        Minimum="0" Maximum="100" ValueChanged="VolumeSlider_ValueChanged" PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown"
        IsEnabled="False" ToolTip="Click anywhere to set the volume, or drag the thumb" AutomationProperties.Name="Volume"/>
      </StackPanel>
     </Grid>
   </Grid>
   </Border>


  </Grid>
 </Border>
</UserControl>
