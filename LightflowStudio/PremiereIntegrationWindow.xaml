<Window x:Class="LightflowStudio.PremiereIntegrationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Premiere Pro Integration" Width="620" Height="560" MinWidth="520" MinHeight="420"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="12">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Premiere Pro Integration" Style="{StaticResource PageTitle}" FontSize="23"/>
   <Border Style="{StaticResource Card}" Margin="0,12,0,12" Padding="12">
    <StackPanel>
     <TextBlock x:Name="ConnectionText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
     <TextBlock x:Name="ProjectText" Margin="0,5,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="GuidanceText" Style="{StaticResource PageSubtitle}" Margin="0,7,0,0"/>
     <Button x:Name="InstallButton" Content="Install Companion…" Style="{StaticResource PrimaryButton}" Click="Install_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </StackPanel>
   </Border>
   <TextBlock Text="Select source media in the Browser and choose Send To → Premiere Pro to choose what to send and its destination." Style="{StaticResource PageSubtitle}" Margin="0,0,0,12"/>
   <Expander Style="{StaticResource SettingsExpanderStyle}" x:Name="SetupHelp" Header="First-time setup" Margin="0,0,0,12">
    <StackPanel Margin="10,0,10,0">
     <TextBlock Style="{StaticResource PageSubtitle}" Text="Adobe requires one folder-access grant so the companion can read Lightflow's protected connection settings. This grants access only to the connection folder; you do not need to find your media or project folder."/>
     <TextBlock Foreground="{StaticResource TextBrush}" FontSize="13" LineHeight="20" Margin="0,8,0,8" TextWrapping="Wrap" Text="1. Click Copy Setup Location below.&#10;2. In Premiere, open Window > UXP Plugins > Lightflow Studio Companion.&#10;3. Click Allow Connection Access. In the folder picker, paste the copied location into the address bar, press Enter, then choose Select Folder.&#10;&#10;The companion remembers this grant and connects automatically on later launches. Keep its panel open while sending."/>
     <Button Content="Copy Setup Location" Click="CopySetup_Click" HorizontalAlignment="Left"/>
    </StackPanel>
   </Expander>
   <Expander Style="{StaticResource SettingsExpanderStyle}" Header="Troubleshooting">
    <StackPanel Margin="10,0,10,0">
     <TextBlock Style="{StaticResource PageSubtitle}" Text="Open the companion panel and choose Resume Connection if it was disconnected. Restarted Lightflow sessions and renewed credentials reconnect automatically. If Adobe says folder access is no longer valid, choose Allow Connection Access again using First-time setup."/>
     <WrapPanel Margin="0,8,0,0">
      <Button Content="Refresh Installation" Click="Refresh_Click"/>
      <Button Content="Install / Update Companion…" Click="Install_Click"/>
      <Button Content="Reset Connection" Click="Pair_Click"/>
     </WrapPanel>
     <TextBlock Margin="0,6,0,0" Style="{StaticResource PageSubtitle}" Text="Reset replaces the connection credential; the companion rereads it automatically. Active handoffs may be interrupted; retry reconciles completed items. To revoke remembered access, choose Forget Connection in the companion's Troubleshooting section."/>
    </StackPanel>
   </Expander>
   <TextBlock x:Name="ResultText" Margin="0,12,0,0" TextWrapping="Wrap"/>
   <Button Content="Done" IsCancel="True" Click="Done_Click" HorizontalAlignment="Right" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer>
 </Border>
</Window>
