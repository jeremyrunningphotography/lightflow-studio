<Window x:Class="LightflowStudio.PremiereIntegrationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Premiere Pro Integration" Width="620" Height="650" MinWidth="520" MinHeight="500"
 WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="Premiere Pro Integration" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock x:Name="ConnectionText" Margin="0,16,0,4" FontSize="16" TextWrapping="Wrap"/>
  <TextBlock x:Name="ProjectText" TextWrapping="Wrap"/>
  <TextBlock x:Name="GuidanceText" Margin="0,8,0,12" TextWrapping="Wrap"/>
  <WrapPanel><Button Content="Install / update companion…" Click="Install_Click" Margin="0,0,8,8"/>
   <Button Content="Refresh installation" Click="Refresh_Click" Margin="0,0,8,8"/>
  </WrapPanel>
  <TextBlock Text="To send media, select sources in the Browser and choose Send to Premiere Pro." Margin="0,8,0,16" TextWrapping="Wrap"/>
  <Expander Header="Connect the companion" Margin="0,0,0,12">
   <StackPanel Margin="0,8,0,0">
    <TextBlock Text="In Premiere, open Window > UXP Plugins > Lightflow Studio Companion and choose Connect to Lightflow. Adobe requires you to grant access to the connection folder below. Select the folder, not the JSON file inside it. Keep the companion panel open while sending." TextWrapping="Wrap"/>
    <TextBox x:Name="PairingPath" IsReadOnly="True" Margin="0,8,0,8" TextWrapping="Wrap"/>
   </StackPanel>
  </Expander>
  <Expander Header="Troubleshooting">
   <StackPanel Margin="0,8,0,0">
    <TextBlock Text="If the companion reports expired or rejected pairing, reset the connection, then choose Connect to Lightflow in the companion and grant folder access again. Resetting interrupts active handoffs; retry will reconcile completed items." TextWrapping="Wrap"/>
    <Button Content="Reset companion connection" Click="Pair_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
   </StackPanel>
  </Expander>
  <TextBlock x:Name="ResultText" Margin="0,12,0,0" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</Window>
