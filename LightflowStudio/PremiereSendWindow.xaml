<Window x:Class="LightflowStudio.PremiereSendWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Send to Premiere Pro" Width="650" Height="720" MinWidth="560" MinHeight="500"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <ScrollViewer x:Name="DialogScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
  <TextBlock Text="Send to Premiere Pro" Style="{StaticResource PageTitle}" FontSize="24"/>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Premiere connection" Style="{StaticResource SectionTitle}"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Refresh" Click="Refresh_Click"/><Button Content="Integration Settings…" Click="Settings_Click"/></StackPanel>
   </Grid>
   <Border x:Name="ConnectionBadge" Margin="0,9,0,0" Padding="8,5" HorizontalAlignment="Left" CornerRadius="6" Background="{StaticResource ReadyBadgeBackgroundBrush}" BorderBrush="{StaticResource ReadyBadgeBorderBrush}" BorderThickness="1"><TextBlock x:Name="ConnectionText" FontWeight="SemiBold"/></Border>
   <StackPanel x:Name="ProjectRow" Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="Project: " Foreground="{StaticResource TextBrush}"/><TextBlock x:Name="ProjectText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/></StackPanel>
   <TextBlock x:Name="CompanionText" Margin="0,3,0,0" Style="{StaticResource PageSubtitle}"/>
   <TextBlock x:Name="ConnectionMessageText" Margin="0,7,0,0" Style="{StaticResource PageSubtitle}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="MediaHeading" Text="Media being sent" Style="{StaticResource SectionTitle}"/>
    <CheckBox x:Name="GlobalUseRangesCheck" Grid.Column="1" VerticalAlignment="Center" Content="Use In/Out points" IsThreeState="False" Checked="GlobalUseRanges_Changed" Unchecked="GlobalUseRanges_Changed" AutomationProperties.Name="Use In and Out points for applicable Premiere sources"/>
   </Grid>
   <ScrollViewer x:Name="SourcesScroll" Style="{StaticResource SourceMediaReviewScrollViewer}" MaxHeight="220" Margin="0,9,0,0" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" KeyboardNavigation.DirectionalNavigation="Continue" PreviewMouseWheel="SourcesScroll_PreviewMouseWheel"><ItemsControl x:Name="Sources" Background="{StaticResource ShellSurfaceBrush}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Padding="4,3" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="0,0,0,1"><StackPanel>
     <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Text="{Binding SourceFileName}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding SourceFileName}"/>
     <Grid x:Name="RangeRow" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
      <CheckBox x:Name="RangeCheck" VerticalAlignment="Center" Content="Use In/Out" IsChecked="{Binding UseRange, Mode=OneWay}" IsEnabled="{Binding RangeControlEnabled}" Checked="RangeUse_Changed" Unchecked="RangeUse_Changed" AutomationProperties.Name="{Binding RangeAutomationName}"/>
      <Border x:Name="RangeTimeline" Grid.Column="1" Height="14" VerticalAlignment="Center" Background="Transparent" Focusable="True" ToolTip="{Binding RangeToolTip}" AutomationProperties.Name="{Binding TimelineAutomationName}"><Canvas Width="240" Height="14"><Border Canvas.Left="0" Canvas.Top="6" Width="240" Height="2" Background="{StaticResource ShellDividerBrush}" CornerRadius="1"/><Border Canvas.Left="{Binding RangeSegmentLeft}" Canvas.Top="5" Width="{Binding RangeSegmentWidth}" Height="4" Background="{StaticResource ShellFocusBrush}" CornerRadius="2"/></Canvas></Border>
     </Grid>
    </StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding HasRange}" Value="False"><Setter TargetName="RangeCheck" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <TextBlock x:Name="RangeMessageText" Margin="0,6,0,0" Style="{StaticResource PageSubtitle}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"><StackPanel>
   <TextBlock Text="Premiere destination" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="Destination bin" Style="{StaticResource FieldLabel}" Margin="0,9,0,3"/>
   <ComboBox x:Name="Bins" DisplayMemberPath="Name" SelectionChanged="Bins_SelectionChanged" AutomationProperties.Name="Premiere destination bin"/>
   <TextBlock Text="Create or reuse a child bin (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"/>
   <TextBox x:Name="NewBinName" MaxLength="100" AutomationProperties.Name="Premiere child bin name"/>
   <TextBlock x:Name="DestinationMessageText" Margin="0,7,0,0" Style="{StaticResource PageSubtitle}"/>
  </StackPanel></Border>
  <DockPanel Margin="0,14,0,0"><TextBlock x:Name="ResultText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/><Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Content="Send to Premiere Pro" Click="Send_Click" HorizontalAlignment="Right"/></DockPanel>
 </StackPanel></ScrollViewer>
</Window>
