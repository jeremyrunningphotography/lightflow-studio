<Window x:Class="LightflowStudio.PremiereSendWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Send to Premiere Pro" Width="650" Height="650" MinWidth="560" MinHeight="500"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
  <TextBlock Text="Send to Premiere Pro" Style="{StaticResource PageTitle}" FontSize="24"/>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Premiere connection" Style="{StaticResource SectionTitle}"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Refresh" Click="Refresh_Click"/><Button Content="Integration Settings…" Click="Settings_Click"/></StackPanel>
   </Grid>
   <Border x:Name="ConnectionBadge" Margin="0,9,0,0" Padding="8,5" HorizontalAlignment="Left" CornerRadius="6" Background="{StaticResource ReadyBadgeBackgroundBrush}" BorderBrush="{StaticResource ReadyBadgeBorderBrush}" BorderThickness="1"><TextBlock x:Name="ConnectionText" FontWeight="SemiBold"/></Border>
   <TextBlock x:Name="ProjectText" Margin="0,7,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
   <TextBlock x:Name="CompanionText" Margin="0,3,0,0" Style="{StaticResource PageSubtitle}"/>
   <TextBlock x:Name="ConnectionMessageText" Margin="0,7,0,0" Style="{StaticResource PageSubtitle}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"><StackPanel>
   <TextBlock Text="Media being sent" Style="{StaticResource SectionTitle}"/>
   <ScrollViewer MaxHeight="180" Margin="0,9,0,0" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Sources"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Padding="7,5" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding RangeSummary}"/></Grid></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <CheckBox x:Name="ApplyRangesCheck" Margin="0,9,0,0" Content="Apply saved In/Out points to video source items" Checked="ApplyRanges_Changed" Unchecked="ApplyRanges_Changed"/>
   <TextBlock x:Name="RangeMessageText" Margin="0,4,0,0" Style="{StaticResource PageSubtitle}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"><StackPanel>
   <TextBlock Text="Premiere destination" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="Destination bin" Style="{StaticResource FieldLabel}" Margin="0,9,0,3"/>
   <ComboBox x:Name="Bins" DisplayMemberPath="Name" SelectionChanged="Bins_SelectionChanged" AutomationProperties.Name="Premiere destination bin"/>
   <TextBlock Text="Create or reuse a child bin (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"/>
   <TextBox x:Name="NewBinName" MaxLength="100" AutomationProperties.Name="Premiere child bin name"/>
   <TextBlock x:Name="DestinationMessageText" Margin="0,7,0,0" Style="{StaticResource PageSubtitle}"/>
  </StackPanel></Border>
  <DockPanel Margin="0,14,0,0"><TextBlock x:Name="ResultText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/><Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Content="Send to Premiere Pro" Click="Send_Click" HorizontalAlignment="Right"/></DockPanel>
 </StackPanel></ScrollViewer>
</Window>
