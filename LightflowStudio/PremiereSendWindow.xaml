<Window x:Class="LightflowStudio.PremiereSendWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Send to Premiere Pro" Width="650" Height="720" MinWidth="560" MinHeight="500"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Window.Resources>
  <Style x:Key="RepresentationModeRadio" TargetType="RadioButton">
   <Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="FocusChrome" Background="Transparent" BorderBrush="{DynamicResource ShellDividerBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid Width="16" Height="16" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource ShellSurfaceBrush}" Stroke="{DynamicResource ShellDividerBrush}" StrokeThickness="1"/><Ellipse x:Name="SelectionDot" Width="8" Height="8" Fill="{DynamicResource ShellFocusBrush}" Visibility="Collapsed"/></Grid><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionDot" Property="Visibility" Value="Visible"/><Setter TargetName="FocusChrome" Property="Background" Value="{DynamicResource ShellSurfaceBrush}"/><Setter TargetName="FocusChrome" Property="BorderBrush" Value="{DynamicResource ShellFocusBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusChrome" Property="Background" Value="{DynamicResource ShellRaisedBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusChrome" Property="BorderBrush" Value="{DynamicResource ShellFocusBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <ScrollViewer x:Name="DialogScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
  <TextBlock Text="Send to Premiere Pro" Style="{StaticResource PageTitle}" FontSize="24"/>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Premiere connection" Style="{StaticResource SectionTitle}"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click"/><Button Content="Integration Settings…" Click="Settings_Click"/></StackPanel>
   </Grid>
   <Border x:Name="ConnectionBadge" Margin="0,9,0,0" Padding="8,5" HorizontalAlignment="Left" CornerRadius="6" Background="{StaticResource ReadyBadgeBackgroundBrush}" BorderBrush="{StaticResource ReadyBadgeBorderBrush}" BorderThickness="1"><TextBlock x:Name="ConnectionText" FontWeight="SemiBold"/></Border>
   <StackPanel x:Name="ProjectRow" Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="Project: " Foreground="{StaticResource TextBrush}"/><TextBlock x:Name="ProjectText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/></StackPanel>
   <TextBlock x:Name="CompanionText" Margin="0,3,0,0" Style="{StaticResource PageSubtitle}"/>
   <TextBlock x:Name="ConnectionMessageText" Margin="0,7,0,0" Style="{StaticResource PageSubtitle}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"><StackPanel>
   <TextBlock Text="What to send" Style="{StaticResource SectionTitle}"/>
   <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <RadioButton x:Name="SourceMediaRadio" Margin="0,0,4,0" Style="{StaticResource RepresentationModeRadio}" GroupName="SendRepresentation" Checked="RepresentationMode_Changed" AutomationProperties.Name="Send videos"><StackPanel><TextBlock FontWeight="SemiBold" Text="Videos"/><TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Send the selected videos"/></StackPanel></RadioButton>
    <RadioButton x:Name="SubclipsRadio" Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource RepresentationModeRadio}" GroupName="SendRepresentation" Checked="RepresentationMode_Changed" AutomationProperties.Name="Send Subclips"><StackPanel><TextBlock FontWeight="SemiBold" Text="Subclips"/><TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Send saved Subclips"/></StackPanel></RadioButton>
   </Grid>
   <TextBlock x:Name="RepresentationHelpText" Margin="0,7,0,8" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
   <TextBlock x:Name="RotationNotice" Margin="0,0,0,8" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" Text="Lightflow rotation is not applied in Premiere. These videos and Subclips use the original source orientation. Export from Lightflow to create media with the rotation applied."/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="MediaHeading" Text="Media being sent" Style="{StaticResource SectionTitle}"/>
    <CheckBox x:Name="GlobalUseRangesCheck" Grid.Column="1" VerticalAlignment="Center" Content="Use In/Out points" IsThreeState="False" Checked="GlobalUseRanges_Changed" Unchecked="GlobalUseRanges_Changed" AutomationProperties.Name="Use In and Out points for applicable videos"/>
   </Grid>
   <ScrollViewer x:Name="SourcesScroll" Style="{StaticResource SourceMediaReviewScrollViewer}" MaxHeight="220" Margin="0,9,0,0" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" KeyboardNavigation.DirectionalNavigation="Continue" PreviewMouseWheel="SourcesScroll_PreviewMouseWheel"><ItemsControl x:Name="Sources" Background="{StaticResource ShellSurfaceBrush}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Padding="4,3" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellDividerBrush}" BorderThickness="0,0,0,1"><StackPanel>
     <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Text="{Binding SourceFileName}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding SourceFileName}"/>
     <TextBlock x:Name="DetailText" Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis"/>
     <Grid x:Name="RangeRow" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
      <CheckBox x:Name="RangeCheck" VerticalAlignment="Center" Content="Use In/Out" IsChecked="{Binding UseRange, Mode=OneWay}" IsEnabled="{Binding RangeControlEnabled}" Checked="RangeUse_Changed" Unchecked="RangeUse_Changed" AutomationProperties.Name="{Binding RangeAutomationName}"/>
      <Border x:Name="RangeTimeline" Grid.Column="1" Height="14" VerticalAlignment="Center" Background="Transparent" Focusable="True" ToolTip="{Binding RangeToolTip}" AutomationProperties.Name="{Binding TimelineAutomationName}"><Canvas Width="240" Height="14"><Border Canvas.Left="0" Canvas.Top="6" Width="240" Height="2" Background="{StaticResource ShellDividerBrush}" CornerRadius="1"/><Border Canvas.Left="{Binding RangeSegmentLeft}" Canvas.Top="5" Width="{Binding RangeSegmentWidth}" Height="4" Background="{StaticResource ShellFocusBrush}" CornerRadius="2"/></Canvas></Border>
     </Grid>
    </StackPanel></Border><DataTemplate.Triggers>
     <DataTrigger Binding="{Binding DetailText}" Value=""><Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding HasRange}" Value="False"><Setter TargetName="RangeCheck" Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding ShowRangeControl}" Value="False"><Setter TargetName="RangeCheck" Property="Visibility" Value="Collapsed"/><Setter TargetName="RangeTimeline" Property="Grid.Column" Value="0"/><Setter TargetName="RangeTimeline" Property="Grid.ColumnSpan" Value="2"/></DataTrigger>
    </DataTemplate.Triggers>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <TextBlock x:Name="RangeMessageText" Margin="0,6,0,0" Style="{StaticResource PageSubtitle}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"><StackPanel>
   <TextBlock Text="Premiere destination" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="Destination bin" Style="{StaticResource FieldLabel}" Margin="0,9,0,3"/>
   <ComboBox x:Name="Bins" DisplayMemberPath="Name" SelectionChanged="Bins_SelectionChanged" AutomationProperties.Name="Premiere destination bin"/>
   <TextBlock Text="New bin inside destination (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"/>
   <TextBox x:Name="NewBinName" MaxLength="100" AutomationProperties.Name="New Premiere bin inside destination"/>
   <TextBlock x:Name="DestinationMessageText" Margin="0,7,0,0" Style="{StaticResource PageSubtitle}"/>
  </StackPanel></Border>
  <DockPanel Margin="0,14,0,0"><TextBlock x:Name="ResultText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/><Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Content="Send to Premiere Pro" Click="Send_Click" HorizontalAlignment="Right"/></DockPanel>
 </StackPanel></ScrollViewer>
</Window>
