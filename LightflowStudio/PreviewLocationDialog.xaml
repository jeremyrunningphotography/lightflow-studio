<Window x:Class="LightflowStudio.PreviewLocationDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Change Previews Location" Width="560" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="12">
  <StackPanel>
   <TextBlock Style="{StaticResource PageTitle}" FontSize="20" Text="Change Previews location"/>
   <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
    Text="Move the existing Previews, or use the new folder and generate Previews as needed. Your Catalog and source media stay in place."/>
   <TextBlock x:Name="DestinationText" Margin="0,12,0,0" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Right">
    <Button Content="Cancel" IsCancel="True"/>
    <Button Content="Rebuild As Needed" Click="Rebuild_Click"/>
    <Button Style="{StaticResource PrimaryButton}" Content="Move Existing" IsDefault="True" Click="Move_Click"/>
   </WrapPanel>
  </StackPanel>
 </Border>
</Window>
