<Window x:Class="LightflowStudio.SmartCollectionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="620" SizeToContent="Height" MaxHeight="780" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="16">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock x:Name="DialogTitle" Style="{StaticResource PageTitle}" FontSize="20" Text="Create Smart Collection"/>
   <TextBlock Text="Name" Margin="0,12,0,4"/>
   <TextBox x:Name="NameText" MaxLength="255" AutomationProperties.Name="Smart Collection name"/>
   <TextBlock Text="Location" Margin="0,10,0,4"/>
   <ComboBox x:Name="LocationCombo" DisplayMemberPath="DisplayName" AutomationProperties.Name="Organizational Location"/>
   <TextBlock Text="Source" Margin="0,10,0,4"/>
   <ComboBox x:Name="SourceKindCombo" SelectionChanged="SourceKindChanged" AutomationProperties.Name="Source type">
    <ComboBoxItem Content="Folder"/><ComboBoxItem Content="Static Collection"/>
   </ComboBox>
   <StackPanel x:Name="FolderPanel" Margin="0,6,0,0" Visibility="Collapsed">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="FolderText" IsReadOnly="True" AutomationProperties.Name="Source folder" VerticalContentAlignment="Center"/>
     <Button Grid.Column="1" Content="Choose Folder…" Click="ChooseFolder_Click"/>
    </Grid>
    <CheckBox x:Name="RecursiveCheck" Content="Include Subfolders" Margin="0,6,0,0"/>
   </StackPanel>
   <ComboBox x:Name="SourceCollectionCombo" Margin="0,6,0,0" DisplayMemberPath="Name" Visibility="Collapsed" AutomationProperties.Name="Source static Collection"/>
   <TextBlock Text="Defining filters" Margin="0,14,0,6"/>
   <ComboBox x:Name="MatchCombo" SelectedIndex="0" AutomationProperties.Name="Match rules">
    <ComboBoxItem Content="Match All fields"/><ComboBoxItem Content="Match Any rule"/>
   </ComboBox>
   <TextBlock Text="Values for the same field are alternatives. Search also narrows the results." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
   <TextBlock Text="Filename or path search" Margin="0,0,0,4"/>
   <TextBox x:Name="SearchText" AutomationProperties.Name="Defining filename or path search" ToolTip="Search filenames and relative paths"/>
   <ListBox x:Name="RulesList" DisplayMemberPath="Label" MinHeight="64" MaxHeight="145" Margin="0,8,0,0" AutomationProperties.Name="Defining rules"
    Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
     <Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="RuleChrome" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="RuleChrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RuleChrome" Property="Background" Value="{StaticResource ShellSelectionBrush}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style></ListBox.ItemContainerStyle>
   </ListBox>
   <Button Content="Remove selected rule" HorizontalAlignment="Right" Click="RemoveRule_Click"/>
   <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="FieldCombo" DisplayMemberPath="Name" SelectionChanged="FieldChanged" AutomationProperties.Name="Rule field"/>
    <ComboBox Grid.Column="1" x:Name="ComparisonCombo" Margin="8,0,0,0" AutomationProperties.Name="Rating comparison"/>
   </Grid>
   <TextBlock x:Name="ValueHint" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,4"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="ValueText" AutomationProperties.Name="Rule value"/>
    <Button Grid.Column="1" Content="Add rule" Click="AddRule_Click"/>
   </Grid>
   <TextBlock x:Name="ErrorText" Foreground="{StaticResource ShellFocusBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
    <Button IsCancel="True" Content="Cancel"/>
    <Button x:Name="SaveButton" IsDefault="True" Content="Create Smart Collection" Click="Save_Click"/>
   </StackPanel>
  </StackPanel></ScrollViewer>
 </Border>
</Window>
