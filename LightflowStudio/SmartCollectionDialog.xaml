<Window x:Class="LightflowStudio.SmartCollectionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="760" SizeToContent="Height" MaxHeight="780" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Window.Resources>
  <DataTemplate x:Key="SmartFilterMatchTemplate">
   <WrapPanel>
    <TextBlock Text="Match" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox Width="76" ItemsSource="{Binding Choices}" DisplayMemberPath="Name"
     SelectedValuePath="Value" SelectedValue="{Binding Value, Mode=TwoWay}" AutomationProperties.Name="Match filters"/>
    <TextBlock Text="of the following filters:" VerticalAlignment="Center" Margin="8,0,0,0"/>
   </WrapPanel>
  </DataTemplate>
 </Window.Resources>
 <Border Margin="9" Style="{StaticResource Card}" Padding="16">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock x:Name="DialogTitle" Style="{StaticResource PageTitle}" FontSize="20" Text="Create Smart Collection"/>
   <TextBlock Text="Name" Margin="0,12,0,4"/>
   <TextBox x:Name="NameText" MaxLength="255" AutomationProperties.Name="Smart Collection name"/>
   <TextBlock Text="Location" Margin="0,10,0,4"/>
   <ComboBox x:Name="LocationCombo" DisplayMemberPath="DisplayName" AutomationProperties.Name="Organizational Location"/>
   <TextBlock Text="Source" Margin="0,10,0,4"/>
   <ComboBox x:Name="SourceKindCombo" SelectionChanged="SourceKindChanged" AutomationProperties.Name="Source type">
    <ComboBoxItem Content="Folder"/><ComboBoxItem Content="Static Collection"/>
   </ComboBox>
   <StackPanel x:Name="FolderPanel" Margin="0,6,0,0" Visibility="Collapsed">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="FolderText" IsReadOnly="True" AutomationProperties.Name="Source folder" VerticalContentAlignment="Center"/>
     <Button Grid.Column="1" Content="Choose Folder…" Click="ChooseFolder_Click"/>
    </Grid>
    <CheckBox x:Name="RecursiveCheck" Content="Include Subfolders" Margin="0,6,0,0"/>
   </StackPanel>
   <ComboBox x:Name="SourceCollectionCombo" Margin="0,6,0,0" DisplayMemberPath="Name" Visibility="Collapsed" AutomationProperties.Name="Source static Collection"/>
   <!-- The complete sentence/control layout is one replaceable WPF resource for localization. -->
   <ContentControl x:Name="MatchHost" Margin="0,16,0,10" ContentTemplate="{StaticResource SmartFilterMatchTemplate}"/>
   <TextBlock x:Name="ValuesStatus" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Background="{StaticResource WindowBrush}">
    <StackPanel>
     <StackPanel x:Name="FilterRows"/>
     <Button x:Name="AddFilterButton" Content="+ Add filter" HorizontalAlignment="Left" Click="AddFilter_Click"/>
    </StackPanel>
   </Border>
   <TextBlock x:Name="ErrorText" Foreground="{StaticResource ShellFocusBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
    <Button IsCancel="True" Content="Cancel"/>
    <Button x:Name="SaveButton" IsDefault="True" Content="Create Smart Collection" Click="Save_Click"/>
   </StackPanel>
  </StackPanel></ScrollViewer>
 </Border>
</Window>
