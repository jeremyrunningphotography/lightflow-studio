<UserControl x:Class="LightflowStudio.SubclipsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:LightflowStudio">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
  <Style x:Key="RangeClearButton" TargetType="Button">
   <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,2,0"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#20242C"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource OrangeBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SubclipActionButton" TargetType="Button" BasedOn="{StaticResource RangeClearButton}">
   <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="2,0,0,0"/>
   <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="12"/>
  </Style>
 </UserControl.Resources>
   <Border x:Name="SubclipsPanel" Padding="8" Background="Transparent" PreviewMouseLeftButtonDown="SubclipsPanel_PreviewMouseLeftButtonDown">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel LastChildFill="False">
      <Button x:Name="AddSubclipButton" DockPanel.Dock="Right" Content="+ Subclip" Padding="8,4"
       Click="AddSubclip_Click" ToolTip="Create from the working range (S)" AutomationProperties.Name="Create Subclip"/>
     </DockPanel>
     <ListBox x:Name="SubclipsList" Grid.Row="1" Margin="0,9,0,0" Background="Transparent" BorderThickness="0" Padding="0"
      ItemsSource="{Binding}" SelectionChanged="SubclipsList_SelectionChanged" MouseDoubleClick="SubclipsList_MouseDoubleClick"
      SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved Subclips">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="Card" Padding="7" Background="#15181E" BorderBrush="#292E37" BorderThickness="1" CornerRadius="6">
          <ContentPresenter/>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#2B181D"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource OrangeBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource OrangeBrush}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#20242C"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate DataType="{x:Type local:SubclipPanelItem}">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Height="58" Background="#090B0F" CornerRadius="4" ClipToBounds="True">
         <Grid>
          <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
           Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
         </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="8,0,0,0">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid x:Name="SubclipNameRow">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="SubclipNameText" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Focusable="True" ToolTip="{Binding Name}"
           AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Name}">
           <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBox x:Name="SubclipNameEditor" Grid.Column="0" Text="{Binding Name, Mode=OneTime}" Foreground="{StaticResource TextBrush}"
           Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibility}}" LostKeyboardFocus="SubclipName_LostKeyboardFocus"
           KeyDown="SubclipName_KeyDown" AutomationProperties.Name="Subclip name editor" AutomationProperties.HelpText="Edit the durable Subclip name"/>
          <Button x:Name="RenameSubclipButton" Grid.Column="1" Tag="{Binding}" Margin="4,0,0,0"
           Click="RenameSubclip_Click" ToolTip="Rename" AutomationProperties.Name="Rename Subclip">
           <Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" SnapsToDevicePixels="True"
            Data="{StaticResource SemanticEditIconGeometry}"/>
           <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SubclipActionButton}"><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
         </Grid>
         <TextBlock Grid.Row="1" Margin="0,3,0,0" Text="{Binding RangeSummary}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
         <DockPanel Grid.Row="2" Margin="0,5,0,0">
          <TextBlock DockPanel.Dock="Left" Text="{Binding DurationSummary}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
           <Button Style="{StaticResource SubclipActionButton}" Content="&#xE74D;" Tag="{Binding}" Click="DeleteSubclip_Click" ToolTip="Delete" AutomationProperties.Name="Delete Subclip"/>
          </StackPanel>
         </DockPanel>
        </Grid>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="SubclipsEmptyText" Grid.Row="1" Text="Set an In or Out point, then press S to save a Subclip."
      TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="18"
      Foreground="{StaticResource MutedTextBrush}"/>
     <Grid x:Name="SubclipsActionBar" Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="DeleteSelectedSubclipsButton" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Padding="9,4"
       Content="Delete" IsEnabled="False" Click="DeleteSelectedSubclips_Click" ToolTip="Delete selected Subclips" AutomationProperties.Name="Delete selected Subclips"/>
      <Button x:Name="ExportSubclipsButton" Grid.Column="1" Style="{StaticResource ExportLaunchButton}" HorizontalAlignment="Right" Padding="9,4"
       Content="Export Subclips…" Click="ExportSubclips_Click" ToolTip="Export selected or all saved Subclips" AutomationProperties.Name="Export saved Subclips">
       <Button.ContextMenu>
        <ContextMenu x:Name="ExportSubclipsMenu" Placement="Bottom" Style="{StaticResource LightflowContextMenuStyle}">
         <MenuItem x:Name="ExportSelectedSubclipsMenuItem" Style="{StaticResource LightflowMenuItemStyle}" Header="Export selected" IsEnabled="False"
          Click="ExportSelectedSubclips_Click" AutomationProperties.Name="Export selected Subclips"/>
         <MenuItem x:Name="ExportAllSubclipsMenuItem" Style="{StaticResource LightflowMenuItemStyle}" Header="Export all" IsEnabled="False"
          Click="ExportAllSubclips_Click" AutomationProperties.Name="Export all Subclips"/>
        </ContextMenu>
       </Button.ContextMenu>
      </Button>
     </Grid>
    </Grid>
   </Border>
</UserControl>
