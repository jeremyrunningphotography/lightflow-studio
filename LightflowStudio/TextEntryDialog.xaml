<Window x:Class="LightflowStudio.TextEntryDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
 <Border Margin="9" Style="{StaticResource Card}" Padding="10">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="PromptText" Style="{StaticResource PageTitle}" FontSize="19" TextWrapping="Wrap"/>
   <TextBox Grid.Row="1" x:Name="ValueText" Margin="0,10,0,0" MaxLength="255"/>
   <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button IsCancel="True" Content="Cancel" Click="Cancel_Click"/>
    <Button IsDefault="True" Content="Save" Click="Save_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
