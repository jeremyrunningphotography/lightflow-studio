<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Color x:Key="ShellCanvasColor">#0B0D11</Color>
 <Color x:Key="ShellSurfaceColor">#11141A</Color>
 <Color x:Key="ShellPanelColor">#171A20</Color>
 <Color x:Key="ShellRaisedColor">#1D2129</Color>
 <Color x:Key="ShellDividerColor">#2B303A</Color>
 <Color x:Key="ShellFocusColor">#FF9A66</Color>
 <Color x:Key="ShellSelectionColor">#282129</Color>
 <Color x:Key="ShellNavigationTextColor">#D8D8DC</Color>

 <SolidColorBrush x:Key="ShellCanvasBrush" Color="{StaticResource ShellCanvasColor}"/>
 <SolidColorBrush x:Key="ShellSurfaceBrush" Color="{StaticResource ShellSurfaceColor}"/>
 <SolidColorBrush x:Key="ShellPanelBrush" Color="{StaticResource ShellPanelColor}"/>
 <SolidColorBrush x:Key="ShellRaisedBrush" Color="{StaticResource ShellRaisedColor}"/>
 <SolidColorBrush x:Key="ShellDividerBrush" Color="{StaticResource ShellDividerColor}"/>
 <SolidColorBrush x:Key="ShellFocusBrush" Color="{StaticResource ShellFocusColor}"/>
 <SolidColorBrush x:Key="ShellSelectionBrush" Color="{StaticResource ShellSelectionColor}"/>
 <SolidColorBrush x:Key="ShellNavigationTextBrush" Color="{StaticResource ShellNavigationTextColor}"/>

 <Thickness x:Key="ShellWorkspacePadding">28,24,28,24</Thickness>
 <Thickness x:Key="ShellPanelPadding">18</Thickness>

 <Style x:Key="ShellPanel" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource ShellPanelBrush}"/>
  <Setter Property="BorderBrush" Value="{StaticResource ShellDividerBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="8"/>
  <Setter Property="Padding" Value="{StaticResource ShellPanelPadding}"/>
 </Style>

 <Style x:Key="ShellWorkspaceTitle" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="FontSize" Value="24"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>

 <Style x:Key="ShellEyebrow" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
  <Setter Property="FontSize" Value="11"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>

 <Style x:Key="ShellPlaceholderTitle" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="FontSize" Value="18"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="TextAlignment" Value="Center"/>
 </Style>

 <Style x:Key="ShellPlaceholderText" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="LineHeight" Value="20"/>
  <Setter Property="TextAlignment" Value="Center"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
</ResourceDictionary>
