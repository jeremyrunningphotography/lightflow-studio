<Window x:Class="LightflowStudio.TrimEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:LightflowStudio"
 Title="Lightflow Studio — Trim Video" Icon="Assets/Branding/LightflowStudio.ico"
 Width="1040" Height="760" MinWidth="820" MinHeight="620"
 WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <Style x:Key="PlaybackTimelineSlider" TargetType="Slider">
   <Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid VerticalAlignment="Center" Height="22">
     <Border Height="6" VerticalAlignment="Center" Background="#0A0C10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"/>
     <Track x:Name="PART_Track" VerticalAlignment="Center" Height="18">
      <Track.DecreaseRepeatButton><RepeatButton Focusable="False" Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="14" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Playhead" Width="5" Height="18" Background="{StaticResource OrangeBrush}" BorderBrush="#FFFFE6" BorderThickness="1" CornerRadius="3"><Border.Effect><DropShadowEffect Color="#FF713D" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/></Border.Effect></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Playhead" Property="Background" Value="{StaticResource RedBrush}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Playhead" Property="Background" Value="{StaticResource MagentaBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Focusable="False" Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{StaticResource WindowBrush}">
  <Border Height="3" VerticalAlignment="Top" Background="{StaticResource BrandGradient}"/>
  <Grid Margin="24,22,24,22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="2,0,2,16">
   <Border DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,14,0" Background="#0A0B0F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"><Image Source="Assets/Branding/jr-glow-source.png" Margin="4" Stretch="Uniform"/></Border>
   <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,5" Background="#2B1E18" BorderBrush="{StaticResource EncodingBadgeBorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Foreground="{StaticResource OrangeBrush}" FontSize="11" FontWeight="SemiBold" Text="FRAME-ACCURATE TRIM"/></Border>
   <StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource PageTitle}" FontSize="24" Text="Trim Video"/><TextBlock x:Name="SourceName" Margin="0,3,12,0" Style="{StaticResource PageSubtitle}" TextTrimming="CharacterEllipsis"/></StackPanel>
  </DockPanel>

  <Border Grid.Row="1" Background="#07090D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
   <Grid x:Name="PreviewHost">
    <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Loading preview…"/>
   </Grid>
  </Border>

  <Border Grid.Row="2" Margin="0,14,0,0" Padding="14,10,14,9" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Slider x:Name="PositionSlider" Style="{StaticResource PlaybackTimelineSlider}" Minimum="0" Maximum="1" ValueChanged="PositionSlider_ValueChanged" PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown" IsEnabled="False" ToolTip="Click anywhere to seek, or drag the playhead"/>
   <local:TrimRangeIndicator x:Name="EditorRangeIndicator" Grid.Row="1" Margin="5,0" HasActiveTrim="True" HasProportions="True"/>
   <Grid Grid.Row="2" Margin="2,2,2,0">
    <TextBlock x:Name="CurrentTimeText" Foreground="{StaticResource TextBrush}" Text="00:00:00.000"/>
    <TextBlock x:Name="DurationText" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" Text="00:00:00.000"/>
   </Grid>
  </Grid>
  </Border>

  <Grid Grid.Row="3" Margin="0,12,0,4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
    <Button x:Name="SetInButton" Content="Set In" Click="SetIn_Click" IsEnabled="False"/>
    <TextBlock x:Name="InTimeText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="In: 00:00:00.000"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
    <Button x:Name="PreviousFrameButton" Content="◀ Frame" Click="PreviousFrame_Click" IsEnabled="False" ToolTip="Previous decoded frame"/>
    <Button x:Name="PlayPauseButton" MinWidth="88" Content="Play" Click="PlayPause_Click" IsEnabled="False"/>
    <Button x:Name="NextFrameButton" Content="Frame ▶" Click="NextFrame_Click" IsEnabled="False" ToolTip="Next decoded frame"/>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
    <TextBlock x:Name="OutTimeText" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Out: 00:00:00.000"/>
    <Button x:Name="SetOutButton" Content="Set Out" Click="SetOut_Click" IsEnabled="False"/>
   </StackPanel>
  </Grid>

  <Grid Grid.Row="4" Margin="0,12,0,0">
   <TextBlock x:Name="MessageText" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="ResetButton" Content="Reset" Click="Reset_Click" IsEnabled="False"/>
    <Button Content="Cancel" Click="Cancel_Click"/>
    <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Content="Apply" Click="Apply_Click" IsEnabled="False"/>
   </StackPanel>
  </Grid>
 </Grid>
 </Grid>
</Window>
